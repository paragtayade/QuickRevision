17. DRIFT DETECTION AND ALERT LOGIC
======================================================================

def detect_drift(response, threshold=40):

    # Step 1: Score response
    drift_result = call_agent(
        drift_detector_prompt,
        response
    )

    # Step 2: Check threshold
    if drift_result["overall_drift_score"] > threshold:

        trigger_alert(drift_result)

        return drift_fallback_response(
            drift_result
        )

    else:

        # Safe to return
        return response


======================================================================
18. DRIFT FALLBACK RESPONSE
======================================================================

def drift_fallback_response(drift_result):

    """Handle drift alerts"""

    return {
        "status": "drift_alert",

        "message":
            "Response quality concerns detected. "
            "Please try rephrasing your query.",

        "drift_details": drift_result,

        "fallback":
            "I'm unable to provide a confident answer "
            "on this topic. Please try a different approach."
    }



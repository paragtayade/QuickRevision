Complete End-to-End Flow**

def process_query_with_safety(user_query, drift_threshold=40):
    """
    Complete edge case handling + drift prevention flow
    """
    
    # PHASE 1: INPUT VALIDATION
    validation = call_agent(input_validator_prompt, user_query)
    
    if validation["validation_status"] != "valid":
        # Invalid input → return fallback immediately
        return edge_case_fallback(validation)
    
    # PHASE 2: MAIN PROCESSING
    response = main_task_agent(user_query)
    
    # PHASE 3: DRIFT DETECTION
    drift = call_agent(drift_detector_prompt, response)
    
    if drift["overall_drift_score"] > drift_threshold:
        # Drift detected → return fallback
        trigger_alert(drift)
        return drift_fallback_response(drift)
    
    # PHASE 4: RETURN SAFE RESPONSE
    return response
**6.
Fallback Handlers**

def edge_case_fallback(validation_result):
    """Handle invalid input edge cases"""
    edge_case_type = validation_result["edge_case_type"]
    
    fallback_messages = {
        "empty_input": "Please provide a non-empty query.",
        "injection": "Invalid request format detected. Please rephrase without override attempts.",
        "out_of_scope": f"This is outside my expertise. {validation_result['suggested_guidance']}",
        "malformed": f"Query format is invalid. {validation_result['suggested_guidance']}",
        "ambiguous": f"Could you clarify? {validation_result['suggested_guidance']}"
    }
    
    return {
        "status": "error",
        "message": fallback_messages.get(edge_case_type, "Invalid request"),
        "guidance": validation_result["suggested_guidance"]
    }

def drift_fallback_response(drift_result):
    """Handle drift alerts"""
    return {
        "status": "drift_alert",
        "message": "Response quality concerns detected. Please try rephrasing your query.",
        "drift_details": drift_result,
        "fallback": "I'm unable to provide a confident answer on this topic. Please try a different approach."
    }

19. COMPLETE END-TO-END IMPLEMENTATION
======================================================================

def process_query_with_safety(
        user_query,
        drift_threshold=40):

    """
    Complete edge-case handling
    + drift-prevention flow
    """

    # PHASE 1: INPUT VALIDATION

    validation = call_agent(
        input_validator_prompt,
        user_query
    )

    if validation["validation_status"] != "valid":

        # Invalid input -> stop processing
        return edge_case_fallback(validation)


    # PHASE 2: MAIN PROCESSING

    response = main_task_agent(user_query)


    # PHASE 3: DRIFT DETECTION

    drift = call_agent(
        drift_detector_prompt,
        response
    )

    if drift["overall_drift_score"] > drift_threshold:

        trigger_alert(drift)

        return drift_fallback_response(drift)


    # PHASE 4: RETURN SAFE RESPONSE

    return response



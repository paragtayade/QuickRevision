PART 8: CODE EXAMPLE — Specialist Agent Orchestration
----------------------------------------------------------------
class SpecialistEnsemble {
  constructor() {
    this.financial_agent = new FinancialAgent();
    this.risk_assessor = new RiskAssessor();
    this.compliance_checker = new ComplianceChecker();
    this.orchestrator = new Orchestrator();
    this.decision_agent = new DecisionAgent();
  }
  
  async analyzeScenario(scenario) {
    // Initialize flow state
    const flowState = {
      scenario: scenario.description,
      competitors: scenario.competitors,
      market_size: scenario.market_size,
      timestamp: new Date().toISOString()
    };
    
    // Step 1: Parallel execution of three specialists
    console.log("Step 1: Running specialist agents in parallel...");
    
    const [financialResult, riskResult, complianceResult] = await Promise.all([
      this.financial_agent.analyze(flowState),
      this.risk_assessor.analyze(flowState),
      this.compliance_checker.analyze(flowState)
    ]);
    
    // Update flow state with specialist outputs
    flowState.financial_analysis = financialResult;
    flowState.risk_assessment = riskResult;
    flowState.compliance_review = complianceResult;
    
    console.log("✓ Specialist analysis complete");
    console.log(`  Financial confidence: ${financialResult.confidence}`);
    console.log(`  Risk confidence: ${riskResult.confidence}`);
    console.log(`  Compliance confidence: ${complianceResult.confidence}`);
    
    // Step 2: Orchestrator synthesizes insights
    console.log("\nStep 2: Synthesizing insights...");
    
    const synthesis = await this.orchestrator.synthesize(flowState);
    flowState.synthesis = synthesis;
    
    console.log("✓ Synthesis complete");
    console.log(`  Agreements: ${synthesis.agreements.length}`);
    console.log(`  Disagreements: ${synthesis.disagreements.length}`);
    console.log(`  Trade-offs: ${synthesis.tradeoffs.length}`);
    
    // Step 3: Decision agent makes final recommendation
    console.log("\nStep 3: Making final decision...");
    
    const decision = await this.decision_agent.decide(flowState);
    flowState.final_recommendation = decision;
    
    console.log("✓ Decision complete");
    console.log(`  Recommendation: ${decision.recommendation}`);
    console.log(`  Confidence: ${decision.confidence}`);
    console.log(`  Next steps: ${decision.next_steps.length}`);
    
    return flowState;
  }
  
  // Helper: Calculate ensemble confidence
  calculateEnsembleConfidence(flowState) {
    const confidences = [
      flowState.financial_analysis.confidence,
      flowState.risk_assessment.confidence,
      flowState.compliance_review.confidence
    ];
    
    // Ensemble confidence = minimum (most conservative)
    return Math.min(...confidences);
  }
  
  // Helper: Identify agreements
  identifyAgreements(flowState) {
    const agreements = [];
    
    const financialRec = flowState.financial_analysis.recommendation;
    const riskRec = flowState.risk_assessment.recommendation;
    const complianceRec = flowState.compliance_review.recommendation;
    
    if (financialRec === riskRec) {
      agreements.push(`Financial and Risk agree: ${financialRec}`);
    }
    
    if (financialRec === complianceRec) {
      agreements.push(`Financial and Compliance agree: ${financialRec}`);
    }
    
    if (riskRec === complianceRec) {
      agreements.push(`Risk and Compliance agree: ${riskRec}`);
    }
    
    return agreements;
  }
  
  // Helper: Identify disagreements
  identifyDisagreements(flowState) {
    const disagreements = [];
    
    const financialRec = flowState.financial_analysis.recommendation;
    const riskRec = flowState.risk_assessment.recommendation;
    const complianceRec = flowState.compliance_review.recommendation;
    
    if (financialRec !== riskRec) {
      disagreements.push({
        agents: "Financial vs Risk",
        financial: financialRec,
        risk: riskRec,
        tradeoff: "High profit potential vs high competitive risk"
      });
    }
    
    if (financialRec !== complianceRec) {
      disagreements.push({
        agents: "Financial vs Compliance",
        financial: financialRec,
        compliance: complianceRec,
        tradeoff: "Profit potential vs compliance requirements"
      });
    }
    
    return disagreements;
  }
}

// Usage
const ensemble = new SpecialistEnsemble();

const scenario = {
  description: "Expand into EV market",
  competitors: ["Tesla", "BYD", "Rivian"],
  market_size: "$50B"
};

const result = await ensemble.analyzeScenario(scenario);

console.log("\n=== FINAL RESULT ===");
console.log(JSON.stringify(result.final_recommendation, null, 2));


61. FACTORY PATTERN IN SPRING BOOT
==============================================================================

PURPOSE:

Creates or selects an implementation based on input without large if-else
blocks.

INTERFACE:

interface PaymentProcessor {

    String getType();

    void process();
}

IMPLEMENTATIONS:

@Component
class CardProcessor
        implements PaymentProcessor {

    public String getType() {
        return "CARD";
    }

    public void process() {
        System.out.println("Card payment");
    }
}

FACTORY:

@Component
class PaymentProcessorFactory {

    private final Map<String, PaymentProcessor>
            processors;

    PaymentProcessorFactory(
            List<PaymentProcessor> processorList) {

        processors = processorList.stream()
            .collect(Collectors.toMap(
                PaymentProcessor::getType,
                Function.identity()
            ));
    }

    PaymentProcessor getProcessor(String type) {

        PaymentProcessor processor =
                processors.get(type);

        if (processor == null) {

            throw new IllegalArgumentException(
                    "Unsupported payment type: "
                    + type
            );
        }

        return processor;
    }
}

USAGE:

factory.getProcessor("CARD").process();


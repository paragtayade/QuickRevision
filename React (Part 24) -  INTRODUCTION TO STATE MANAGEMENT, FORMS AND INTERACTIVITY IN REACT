WHAT IS FORM VALIDATION?
--------------------------------------------------------------------------------

Form validation is:

• Checking Data Before Submission
  - Ensures data meets expected requirements

• Client-Side Validation
  - Validation performed in the browser

• User Feedback
  - Shows errors to help users correct inputs

• Data Quality
  - Helps prevent invalid data

• Better User Experience
  - Provides immediate feedback

• Additional Validation Layer
  - Client-side validation complements server-side validation

• User Guidance
  - Helps users correct mistakes


COMMON VALIDATION RULES
--------------------------------------------------------------------------------

+------------+-----------------------------+-----------------------------+
| FIELD TYPE | VALIDATION RULE             | EXAMPLE                     |
+------------+-----------------------------+-----------------------------+
| Email      | Valid email format          | user@example.com            |
| Password   | Minimum 6-8 characters      | {PASSWORD}                  |
| Phone      | Expected phone format       | (555) 123-4567              |
| URL        | Valid URL format            | https://example.com         |
| Number     | Must be numeric             | 42                          |
| Required   | Cannot be empty             | Any non-empty value         |
| Min Length | Length >= specified         | At least 8 characters       |
| Max Length | Length <= specified         | No more than 50 characters  |
| Pattern    | Matches required regex      | ^[A-Z][a-z]+$               |
| Checkbox   | Must be checked             | checked = true              |
| Select     | Must have valid selection   | Not default option          |
+------------+-----------------------------+-----------------------------+


NOTE:
Client-side validation improves UX, but security-sensitive validation must
also be enforced by the server.


================================================================================
ADVANCED FORM WITH VALIDATION
================================================================================

import { useState } from 'react'

export default function ValidatedForm() {

  // Form data state
  const [formData, setFormData] = useState({
    username: '',
    email: '',
    password: '',
    confirmPassword: '',
    age: ''
  })


  // Errors state
  const [errors, setErrors] = useState({})


  // Touched state
  // Tracks which fields user has interacted with
  const [touched, setTouched] = useState({})


  // Validation function for individual fields

  const validateField = (name, value) => {

    let error = ''

    switch (name) {

      case 'username':

        if (!value) {
          error = 'Username is required'
        } else if (value.length < 3) {
          error = 'Username must be at least 3 characters'
        }

        break


      case 'email':

        if (!value) {
          error = 'Email is required'
        } else if (!value.includes('@')) {
          error = 'Email must be valid'
        }

        break


      case 'password':

        if (!value) {
          error = 'Password is required'
        } else if (value.length < 6) {
          error = 'Password must be at least 6 characters'
        }

        break


      case 'confirmPassword':

        if (!value) {
          error = 'Please confirm password'
        } else if (value !== formData.password) {
          error = 'Passwords do not match'
        }

        break


      case 'age':

        if (!value) {
          error = 'Age is required'
        } else if (value < 18) {
          error = 'You must be at least 18 years old'
        }

        break


      default:
        break
    }

    return error
  }


  // Handle input change

  const handleChange = (e) => {

    const { name, value } = e.target

    // Update form data
    setFormData({
      ...formData,
      value
    })


    // Validate field if it has been touched
    if (touched[name]) {

      const error = validateField(name, value)

      setErrors({
        ...errors,
        error
      })
    }
  }


  // Handle field blur
  // Mark field as touched

  const handleBlur = (e) => {

    const { name, value } = e.target

    setTouched({
      ...touched,
      true
    })


    // Validate field
    const error = validateField(name, value)

    setErrors({
      ...errors,
      error
    })
  }


  // Validate entire form

  const validateForm = () => {

    const newErrors = {}

    Object.keys(formData).forEach(field => {

      const error =
        validateField(field, formData[field])

      if (error) {
        newErrors[field] = error
      }
    })

    return newErrors
  }


  // Handle form submission

  const handleSubmit = (e) => {

    e.preventDefault()

    const newErrors = validateForm()


    if (Object.keys(newErrors).length === 0) {

      // Form is valid

      console.log('Form submitted:', formData)

      alert('Registration successful!')


      // Reset form

      setFormData({
        username: '',
        email: '',
        password: '',
        confirmPassword: '',
        age: ''
      })

      setErrors({})
      setTouched({})

    } else {

      // Form has errors

      setErrors(newErrors)


      // Mark all fields as touched to show all errors

      setTouched({
        username: true,
        email: true,
        password: true,
        confirmPassword: true,
        age: true
      })
    }
  }


  // Determine whether an error should be shown

  const showError = (fieldName) => {
    return touched[fieldName] && errors[fieldName]
  }


  return (
    <div className="form-container">

      <h1>
        Registration Form with Validation
      </h1>


      <form onSubmit={handleSubmit}>


        {/* Username Field */}

        <div className="form-group">

          <label htmlFor="username">
            Username:
          </label>

          <input
            id="username"
            type="text"
            name="username"
            value={formData.username}
            onChange={handleChange}
            onBlur={handleBlur}
            placeholder="Enter username"
            className={
              showError('username')
                ? 'input-error'
                : ''
            }
          />

          {showError('username') && (
            <p className="error-text">
              {errors.username}
            </p>
          )}

        </div>


        {/* Email Field */}

        <div className="form-group">

          <label htmlFor="email">
            Email:
          </label>

          <input
            id="email"
            type="email"
            name="email"
            value={formData.email}
            onChange={handleChange}
            onBlur={handleBlur}
            placeholder="Enter email"
            className={
              showError('email')
                ? 'input-error'
                : ''
            }
          />

          {showError('email') && (
            <p className="error-text">
              {errors.email}
            </p>
          )}

        </div>


        {/* Password Field */}

        <div className="form-group">

          <label htmlFor="password">
            Password:
          </label>

          <input
            id="password"
            type="password"
            name="password"
            value={formData.password}
            onChange={handleChange}
            onBlur={handleBlur}
            placeholder="Enter password"
            className={
              showError('password')
                ? 'input-error'
                : ''
            }
          />

          {showError('password') && (
            <p className="error-text">
              {errors.password}
            </p>
          )}

        </div>


        {/* Confirm Password Field */}

        <div className="form-group">

          <label htmlFor="confirmPassword">
            Confirm Password:
          </label>

          <input
            id="confirmPassword"
            type="password"
            name="confirmPassword"
            value={formData.confirmPassword}
            onChange={handleChange}
            onBlur={handleBlur}
            placeholder="Confirm password"
            className={
              showError('confirmPassword')
                ? 'input-error'
                : ''
            }
          />

          {showError('confirmPassword') && (
            <p className="error-text">
              {errors.confirmPassword}
            </p>
          )}

        </div>


        {/* Age Field */}

        <div className="form-group">

          <label htmlFor="age">
            Age:
          </label>

          <input
            id="age"
            type="number"
            name="age"
            value={formData.age}
            onChange={handleChange}
            onBlur={handleBlur}
            placeholder="Enter age"
            className={
              showError('age')
                ? 'input-error'
                : ''
            }
          />

          {showError('age') && (
            <p className="error-text">
              {errors.age}
            </p>
          )}

        </div>


        {/* Submit Button */}

        <button
          type="submit"
          className="btn btn-submit"
        >
          Register
        </button>

      </form>


      {/* Form Status Summary */}

      <div className="form-summary">

        <h3>Form Status:</h3>

        <p>
          Fields Touched:
          {Object.values(touched).filter(Boolean).length}
        </p>

        <p>
          Errors:
          {Object.values(errors).filter(Boolean).length}
        </p>

        <p>
          Valid:
          {Object.values(errors).filter(Boolean).length === 0
            ? 'Yes'
            : 'No'}
        </p>

      </div>

    </div>
  )
}



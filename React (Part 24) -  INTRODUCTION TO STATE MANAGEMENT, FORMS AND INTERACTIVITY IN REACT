WHAT IS A FORM IN REACT?
--------------------------------------------------------------------------------

A form in React can contain:

• Collection of Input Fields
  - Text inputs
  - Checkboxes
  - Selects
  - Textareas
  - etc.

• State-Controlled Values
  - Inputs can be managed through React state

• User Input Handling
  - Captures and processes user-entered data

• Validation
  - Checks whether data meets requirements

• Submission
  - Processes data locally or sends it to another system

• User Feedback
  - Displays errors and success messages

• Form State
  - Can track input values, errors, touched fields, submission status, etc.


================================================================================
BASIC FORM COMPONENT EXAMPLE
================================================================================

The following code shows a login form with validation:


import { useState } from 'react'

export default function SimpleForm() {

  // State for form inputs
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [submitted, setSubmitted] = useState(false)
  const [error, setError] = useState('')


  // Handle email input change
  const handleEmailChange = (e) => {

    setEmail(e.target.value)

    // Clear error when user starts typing
    if (error) {
      setError('')
    }
  }


  // Handle password input change
  const handlePasswordChange = (e) => {

    setPassword(e.target.value)

    // Clear error when user starts typing
    if (error) {
      setError('')
    }
  }


  // Validate form data
  const validateForm = () => {

    // Check if email is empty
    if (!email) {
      return 'Email is required'
    }

    // Check if email contains @
    if (!email.includes('@')) {
      return 'Email must be valid'
    }

    // Check if password is empty
    if (!password) {
      return 'Password is required'
    }

    // Check if password is at least 6 characters
    if (password.length < 6) {
      return 'Password must be at least 6 characters'
    }

    // No errors found
    return ''
  }


  // Handle form submission
  const handleSubmit = (e) => {

    // Prevent page reload
    e.preventDefault()

    // Validate form
    const validationError = validateForm()

    if (validationError) {

      // Form has errors
      setError(validationError)

    } else {

      // Form is valid
      console.log('Form submitted with:', {
        email,
        password
      })

      setSubmitted(true)

      // Reset form after 2 seconds
      setTimeout(() => {
        setEmail('')
        setPassword('')
        setSubmitted(false)
      }, 2000)
    }
  }


  return (
    <div className="form-container">

      <h1>Login Form</h1>


      {/* Success message */}

      {submitted && (
        <div className="success-message">
          <p>
            Login successful!
            Redirecting...
          </p>
        </div>
      )}


      {/* Error message */}

      {error && (
        <div className="error-message">
          <p>{error}</p>
        </div>
      )}


      {/* Form element */}

      <form onSubmit={handleSubmit}>


        {/* Email input field */}

        <div className="form-group">

          <label htmlFor="email">
            Email:
          </label>

          <input
            id="email"
            type="email"
            value={email}
            onChange={handleEmailChange}
            placeholder="Enter your email"
            className={
              error && !email.includes('@')
                ? 'input-error'
                : ''
            }
          />

        </div>


        {/* Password input field */}

        <div className="form-group">

          <label htmlFor="password">
            Password:
          </label>

          <input
            id="password"
            type="password"
            value={password}
            onChange={handlePasswordChange}
            placeholder="Enter your password"
            className={
              error && password.length < 6
                ? 'input-error'
                : ''
            }
          />

        </div>


        {/* Submit button */}

        <button
          type="submit"
          className="btn btn-submit"
        >
          Login
        </button>

      </form>


      {/* Display current form data */}

      <div className="form-data">

        <h3>Current Form Data:</h3>

        <p>
          Email: {email || '(empty)'}
        </p>

        <p>
          Password: {password ? '••••••' : '(empty)'}
        </p>

      </div>

    </div>
  )
}



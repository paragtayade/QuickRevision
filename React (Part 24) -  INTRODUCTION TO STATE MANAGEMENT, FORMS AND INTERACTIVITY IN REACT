================================================================================
EVENT HANDLER EXAMPLE
================================================================================

import { useState } from 'react'

export default function EventHandlers() {

  const [count, setCount] = useState(0)
  const [message, setMessage] = useState('')
  const [hovered, setHovered] = useState(false)


  // onClick handler

  const handleClick = () => {
    setCount(count + 1)
  }


  // onChange handler

  const handleChange = (e) => {
    setMessage(e.target.value)
  }


  // onSubmit handler

  const handleSubmit = (e) => {

    e.preventDefault()

    console.log('Submitted:', message)

    setMessage('')
  }


  // onMouseEnter handler

  const handleMouseEnter = () => {
    setHovered(true)
  }


  // onMouseLeave handler

  const handleMouseLeave = () => {
    setHovered(false)
  }


  return (
    <div className="event-handlers">


      {/* onClick Example */}

      <div className="section">

        <h2>Click Counter</h2>

        <p>Count: {count}</p>

        <button onClick={handleClick}>
          Click Me ({count} times)
        </button>

      </div>


      {/* onChange Example */}

      <div className="section">

        <h2>Text Input</h2>

        <input
          type="text"
          value={message}
          onChange={handleChange}
          placeholder="Type something..."
        />

        <p>
          You typed: {message}
        </p>

      </div>


      {/* onSubmit Example */}

      <div className="section">

        <h2>Form Submission</h2>

        <form onSubmit={handleSubmit}>

          <input
            type="text"
            placeholder="Enter text"
            value={message}
            onChange={handleChange}
          />

          <button type="submit">
            Submit
          </button>

        </form>

      </div>


      {/* onMouseEnter / onMouseLeave Example */}

      <div className="section">

        <h2>Hover Effect</h2>

        <div
          onMouseEnter={handleMouseEnter}
          onMouseLeave={handleMouseLeave}
          className={
            hovered
              ? 'box-hovered'
              : 'box-normal'
          }
        >
          {hovered
            ? 'Hovering!'
            : 'Hover over me'}
        </div>

      </div>

    </div>
  )
}


WHAT THIS CODE DOES
--------------------------------------------------------------------------------

This example demonstrates:

• onClick
  - Updates state when a button is clicked

• onChange
  - Updates state as the user types

• onSubmit
  - Handles form submission using preventDefault()

• onMouseEnter / onMouseLeave
  - Tracks hover state

• Event Object (e)
  - Provides event information such as e.target.value

• State Updates
  - Event handlers update appropriate state

• Conditional Rendering
  - UI changes based on state values



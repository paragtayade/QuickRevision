SIMPLE COUNTER COMPONENT EXAMPLE
================================================================================

The following code demonstrates a counter application using state:


import { useState } from 'react'

export default function Counter() {

  // Create state variable 'count' with initial value 0
  const [count, setCount] = useState(0)


  // Function to increment count by 1
  const handleIncrement = () => {
    setCount(count + 1)
  }


  // Function to decrement count by 1
  const handleDecrement = () => {
    setCount(count - 1)
  }


  // Function to reset count to 0
  const handleReset = () => {
    setCount(0)
  }


  return (
    <div className="counter-container">

      <h1>Counter Application</h1>


      {/* Display current count value */}

      <div className="count-display">

        <p>
          Current Count:
          <span className="count-value">
            {count}
          </span>
        </p>

      </div>


      {/* Buttons to modify count */}

      <div className="button-group">

        <button
          onClick={handleDecrement}
          className="btn btn-decrease"
        >
          Decrease
        </button>

        <button
          onClick={handleReset}
          className="btn btn-reset"
        >
          Reset
        </button>

        <button
          onClick={handleIncrement}
          className="btn btn-increase"
        >
          Increase
        </button>

      </div>


      {/* Display status message based on count value */}

      <div className="status-message">

        {count === 0 && (
          <p>Count is at zero</p>
        )}

        {count > 0 && (
          <p>Count is positive: {count}</p>
        )}

        {count < 0 && (
          <p>Count is negative: {count}</p>
        )}

      </div>


      {/* Display count statistics */}

      <div className="statistics">

        <p>
          Total increments: {Math.max(0, count)}
        </p>

        <p>
          Status:
          {count > 10
            ? 'High'
            : count > 5
            ? 'Medium'
            : 'Low'}
        </p>

      </div>

    </div>
  )
}



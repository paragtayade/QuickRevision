import { useState } from 'react'


export default function TodoList() {

  // ❌ WRONG - Regular mutable array

  let todos = [

    {
      id: 1,
      text: 'Learn React',
      completed: false
    },

    {
      id: 2,
      text: 'Build a project',
      completed: false
    }

  ]


  const handleAddTodo = (newTodo) => {

    todos.push(newTodo)

    console.log(
      'Todo added:',
      todos
    )
  }


  const handleRemoveTodo = (id) => {

    const index =
      todos.findIndex(
        todo => todo.id === id
      )

    todos.splice(index, 1)

    console.log(
      'Todo removed:',
      todos
    )
  }


  const handleToggleTodo = (id) => {

    const todo =
      todos.find(
        todo => todo.id === id
      )

    todo.completed =
      !todo.completed

    console.log(
      'Todo toggled:',
      todos
    )
  }


  return (
    <div className="todo-list">

      <h2>My Todos</h2>

      <ul>

        {todos.map(todo => (

          <li key={todo.id}>

            <input
              type="checkbox"
              checked={todo.completed}
              onChange={() =>
                handleToggleTodo(todo.id)
              }
            />

            <span>
              {todo.text}
            </span>

            <button
              onClick={() =>
                handleRemoveTodo(todo.id)
              }
            >
              Delete
            </button>

          </li>

        ))}

      </ul>


      <button
        onClick={() =>
          handleAddTodo({
            id: 3,
            text: 'New Todo',
            completed: false
          })
        }
      >
        Add Todo
      </button>


      <p>
        Local mutations aren't being managed
        as React state.
      </p>

    </div>
  )
}


PROBLEMS WITH THIS APPROACH
--------------------------------------------------------------------------------

• todos is a regular local array

• push() mutates the array

• splice() mutates the array

• todo.completed assignment mutates an object

• No state setter is called

• Changes aren't represented as React state updates

• Component UI isn't reliably synchronized


================================================================================
AFTER: TODO LIST WITH useState
================================================================================

import { useState } from 'react'


export default function TodoList() {

  const [todos, setTodos] = useState([

    {
      id: 1,
      text: 'Learn React',
      completed: false
    },

    {
      id: 2,
      text: 'Build a project',
      completed: false
    }

  ])


  // Add todo immutably

  const handleAddTodo = (newTodo) => {

    setTodos([
      ...todos,
      newTodo
    ])
  }


  // Remove todo immutably

  const handleRemoveTodo = (id) => {

    setTodos(
      todos.filter(
        todo => todo.id !== id
      )
    )
  }


  // Toggle todo immutably

  const handleToggleTodo = (id) => {

    setTodos(
      todos.map(todo =>

        todo.id === id
          ? {
              ...todo,
              completed: !todo.completed
            }
          : todo

      )
    )
  }


  return (
    <div className="todo-list">

      <h2>
        My Todos ({todos.length})
      </h2>


      <ul>

        {todos.map(todo => (

          <li key={todo.id}>

            <input
              type="checkbox"
              checked={todo.completed}
              onChange={() =>
                handleToggleTodo(todo.id)
              }
            />

            <span
              style={{
                textDecoration:
                  todo.completed
                    ? 'line-through'
                    : 'none'
              }}
            >
              {todo.text}
            </span>

            <button
              onClick={() =>
                handleRemoveTodo(todo.id)
              }
            >
              Delete
            </button>

          </li>

        ))}

      </ul>


      <button
        onClick={() =>
          handleAddTodo({
            id: todos.length + 1,
            text: 'New Todo',
            completed: false
          })
        }
      >
        Add Todo
      </button>


      <p>
        UI updates when todos state changes.
      </p>

    </div>
  )
}


IMMUTABLE ARRAY OPERATIONS
--------------------------------------------------------------------------------

+----------------+-------------------------+-----------------------------------+
| OPERATION      | AVOID                   | IMMUTABLE APPROACH                |
+----------------+-------------------------+-----------------------------------+
| Add            | push()                  | [...todos, newTodo]               |
| Remove         | splice()                | filter()                          |
| Update Item    | item.prop = value       | map() + {...item}                 |
| Sort           | todos.sort()            | [...todos].sort()                 |
| Reverse        | todos.reverse()         | [...todos].reverse()              |
+----------------+-------------------------+-----------------------------------+


LINE-BY-LINE EXPLANATION
--------------------------------------------------------------------------------

+--------------------------------------+---------------------------------------+
| CODE / CONCEPT                       | WHAT IT DOES                          |
+--------------------------------------+---------------------------------------+
| useState([...])                      | Creates todos state array             |
| setTodos                             | Updates todos state                   |
| [...todos, newTodo]                  | Creates array with new item           |
| todos.filter(...)                    | Creates array excluding an item       |
| todos.map(...)                       | Creates updated array                 |
| {...todo}                            | Copies matching todo                  |
| completed: !todo.completed           | Toggles completed value               |
| todos.length                         | Shows current number of todos         |
| key={todo.id}                        | Stable identity for list rendering    |
+--------------------------------------+---------------------------------------+


HOW ADD WORKS
--------------------------------------------------------------------------------

Current Todos
      ↓
Spread Existing Items
      ↓
Append newTodo
      ↓
New Array
      ↓
setTodos()
      ↓
React Processes Update
      ↓
List Re-renders


HOW REMOVE WORKS
--------------------------------------------------------------------------------

Current Todos
      ↓
filter()
      ↓
Exclude Matching ID
      ↓
New Array
      ↓
setTodos()
      ↓
List Re-renders


HOW TOGGLE WORKS
--------------------------------------------------------------------------------

Current Todos
      ↓
map()
      ↓
Check Each ID
      ↓
   +--------------+
   |              |
 Match         No Match
   |              |
   ↓              ↓
New Object     Same Item
   |
Toggle completed
   ↓
New Array
   ↓
setTodos()
   ↓
List Re-renders


IMPORTANT NOTE ABOUT IDs
--------------------------------------------------------------------------------

This example uses:

id: todos.length + 1

for simplicity.

In real applications, this can create duplicate IDs after deletions.

Example:

IDs = 1, 2, 3

Delete ID 2

Remaining:
1, 3

todos.length + 1 = 3

New item would incorrectly reuse ID 3.

Use a genuinely unique identifier strategy in a real application.



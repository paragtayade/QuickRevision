import './QuoteCard.css'


export default function QuoteCard({
  quote,
  loading,
  error
}) {

  return (
    <div className="quote-card-container">


      {/* Error Message */}

      {error && (

        <div
          className="alert alert-danger"
          role="alert"
        >
          {error}
        </div>


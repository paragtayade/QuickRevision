          className="spinner-border"
          role="status"
        >

          <span className="visually-hidden">
            Loading...
          </span>

        </div>

      )}


      {/* Quote Card */}

      {!loading && !error && (

        <div className="quote-card">

          <blockquote className="blockquote">

            {/* Quote Text */}

            <p className="quote-text">
              "{quote.text}"
            </p>


            {/* Quote Author */}

            <footer className="blockquote-footer">

              <span className="quote-author">
                {quote.author}
              </span>

            </footer>

          </blockquote>

        </div>

      )}

    </div>
  )
}



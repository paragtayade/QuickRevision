import {
  useCallback,
  useEffect,
  useState
} from 'react'

import QuoteCard
  from './components/QuoteCard'

import {
  fetchRandomQuote
} from './utils/quoteApi'

import './App.css'


const COLORS = [
  '#667eea',
  '#764ba2',
  '#f093fb',
  '#4facfe',
  '#00f2fe',
  '#43e97b',
  '#fa709a',
  '#fee140',
  '#30cfd0',
  '#330867'
]


export default function App() {

  const [quote, setQuote] =
    useState({

      text:
        'The only way to do great work is to love what you do.',

      author:
        'Steve Jobs'

    })


  const [loading, setLoading] =
    useState(false)


  const [error, setError] =
    useState(null)


  const [color, setColor] =
    useState(COLORS[0])


  const getRandomColor = () => {

    const randomIndex =
      Math.floor(
        Math.random() *
        COLORS.length
      )

    return COLORS[randomIndex]
  }


  const getNewQuote =
    useCallback(async () => {

      setLoading(true)

      setError(null)


      try {

        const newQuote =
          await fetchRandomQuote()


        setQuote(newQuote)

        setColor(
          getRandomColor()
        )

      } catch (err) {

        setError(
          'Failed to fetch quote. Please try again.'
        )

        console.error(
          'Error fetching quote:',
          err
        )

      } finally {

        setLoading(false)

      }

    }, [])


  const tweetQuote = () => {

    const tweetText =
      `"${quote.text}" — ${quote.author}`


    const twitterUrl =
      `https://twitter.com/intent/tweet?text=${
        encodeURIComponent(tweetText)
      }`


    window.open(
      twitterUrl,
      '_blank',
      'width=550,height=420'
    )
  }


  useEffect(() => {

    const handleKeyPress = (e) => {

      if (
        e.code === 'Space' &&
        !loading
      ) {

        const tagName =
          e.target.tagName


        if (
          tagName === 'INPUT' ||
          tagName === 'TEXTAREA' ||
          tagName === 'SELECT'
        ) {

          return

        }


        e.preventDefault()

        getNewQuote()
      }
    }


    window.addEventListener(
      'keydown',
      handleKeyPress
    )


    return () => {

      window.removeEventListener(
        'keydown',
        handleKeyPress
      )

    }

  }, [getNewQuote, loading])


  useEffect(() => {

    getNewQuote()

  }, [getNewQuote])


  return (
    <div
      className="
        min-vh-100
        d-flex
        align-items-center
        justify-content-center
        py-5
      "
      style={{
        background:
          `linear-gradient(
            135deg,
            ${color} 0%,
            ${color}cc 100%
          )`
      }}
    >

      <div className="container">


        {/* Header */}

        <header className="text-center mb-5">

          <h1 className="display-4 fw-bold text-white mb-3">

            Random Quote Generator

          </h1>


          <p className="lead text-white-50">

            Press spacebar or click the button
            for a new quote

          </p>

        </header>


        {/* Quote */}

        <div className="row justify-content-center mb-5">

          <div className="col-12 col-lg-8">

            <QuoteCard
              quote={quote}
              loading={loading}
              error={error}
              color={color}
            />

          </div>

        </div>


        {/* Actions */}

        <div className="row justify-content-center">

          <div className="col-12 col-lg-8">

            <div className="d-flex gap-3 justify-content-center flex-wrap">


              <button
                onClick={getNewQuote}
                disabled={loading}
                className="btn btn-light btn-lg fw-bold"
                title="Click or press spacebar for a new quote"
              >

                {loading ? (

                  <>

                    <span
                      className="spinner-border spinner-border-sm me-2"
                      role="status"
                      aria-hidden="true"
                    >
                    </span>

                    Loading...

                  </>

                ) : (

                  <>

                    <i className="bi bi-arrow-repeat me-2"></i>

                    New Quote

                  </>

                )}

              </button>


              <button
                onClick={tweetQuote}
                disabled={loading}
                className="btn btn-info btn-lg fw-bold text-white"
                title="Share this quote"
              >

                <i className="bi bi-twitter me-2"></i>

                Tweet

              </button>

            </div>

          </div>

        </div>


        {/* Footer */}

        <footer className="text-center mt-5">

          <p className="text-white-50">
            Random Quote App
          </p>

        </footer>

      </div>

    </div>
  )
}



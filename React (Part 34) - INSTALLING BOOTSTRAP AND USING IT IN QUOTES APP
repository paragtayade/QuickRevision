export default function GoodExample() {

  return (
    <div className="container py-5">

      <div className="row g-4">

        <div className="col-12 col-md-6 col-lg-4">

          <div className="card h-100 shadow-sm">

            <div className="card-body">

              <h5 className="card-title">
                Card Title
              </h5>

              <p className="card-text">
                Card description
              </p>

              <button className="btn btn-primary">
                Action
              </button>

            </div>

          </div>

        </div>

      </div>

    </div>
  )
}


WHY THIS WORKS WELL
--------------------------------------------------------------------------------

• Bootstrap grid manages responsive layout

• Spacing uses Bootstrap utilities

• Card uses Bootstrap component classes

• Button uses Bootstrap styles

• Minimal additional CSS is required



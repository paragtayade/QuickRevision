import {
  useCallback,
  useEffect,
  useState
} from 'react'

import QuoteContainer
  from './components/QuoteContainer'

import QuoteDisplay
  from './components/QuoteDisplay'

import QuoteActions
  from './components/QuoteActions'

import {
  fetchRandomQuote
} from './utils/quoteApi'

import './App.css'


const COLORS = [

  '#667eea',

  '#764ba2',

  '#f093fb',

  '#4facfe',

  '#00f2fe',

  '#43e97b',

  '#fa709a',

  '#fee140',

  '#30cfd0',

  '#330867'

]


const getRandomColor = () => {

  const randomIndex =
    Math.floor(
      Math.random() *
      COLORS.length
    )


  return COLORS[randomIndex]
}


export default function App() {

  // ============================================
  // STATE
  // ============================================

  const [quote, setQuote] =
    useState({

      text:
        'The only way to do great work is to love what you do.',

      author:
        'Steve Jobs'

    })


  const [loading, setLoading] =
    useState(false)


  const [error, setError] =
    useState(null)


  const [color, setColor] =
    useState(COLORS[0])


  // ============================================
  // HANDLERS
  // ============================================

  const handleGetNewQuote =
    useCallback(async () => {

      setLoading(true)

      setError(null)


      try {

        const newQuote =
          await fetchRandomQuote()


        setQuote(newQuote)


        setColor(
          getRandomColor()
        )


        console.log(
          'Quote fetched successfully:',
          newQuote
        )

      } catch (err) {

        setError(
          'Failed to fetch quote. Please try again.'
        )


        console.error(
          'Error fetching quote:',
          err
        )

      } finally {

        setLoading(false)

      }

    }, [])


  const handleTweetQuote = () => {

    const tweetText =
      `"${quote.text}" — ${quote.author}`


    const twitterUrl =
      `https://twitter.com/intent/tweet?text=${
        encodeURIComponent(tweetText)
      }`


    window.open(
      twitterUrl,
      '_blank',
      'width=550,height=420'
    )
  }


  // ============================================
  // EFFECTS
  // ============================================

  useEffect(() => {

    const handleKeyPress = (e) => {

      if (
        e.code === 'Space' &&
        !loading
      ) {

        const tagName =
          e.target.tagName


        if (
          tagName === 'INPUT' ||
          tagName === 'TEXTAREA' ||
          tagName === 'SELECT'
        ) {

          return
        }


        e.preventDefault()


        handleGetNewQuote()
      }
    }


    window.addEventListener(
      'keydown',
      handleKeyPress
    )


    return () => {

      window.removeEventListener(
        'keydown',
        handleKeyPress
      )

    }

  }, [
    handleGetNewQuote,
    loading
  ])


  useEffect(() => {

    handleGetNewQuote()

  }, [handleGetNewQuote])


  // ============================================
  // RENDER
  // ============================================

  return (
    <QuoteContainer
      color={color}
    >


      {/* Header */}

      <header className="text-center mb-5">

        <h1 className="display-4 fw-bold text-white mb-3">

          Random Quote Generator

        </h1>


        <p className="lead text-white-50">

          Press spacebar or click button
          for a new quote

        </p>

      </header>


      {/* Quote Display */}

      <div className="row justify-content-center mb-5">

        <div className="col-12 col-lg-8">

          <QuoteDisplay
            quote={quote}
            loading={loading}
            error={error}
            color={color}
          />

        </div>

      </div>


      {/* Actions */}

      <div className="row justify-content-center">

        <div className="col-12 col-lg-8">

          <QuoteActions
            onNewQuote={
              handleGetNewQuote
            }
            onTweet={
              handleTweetQuote
            }
            loading={loading}
          />

        </div>

      </div>


      {/* Footer */}

      <footer className="text-center mt-5">

        <p className="text-white-50">

          Random Quote App

        </p>

      </footer>


    </QuoteContainer>
  )
}



================================================================================ PART 5: BUILDING A SIMPLE FORM IN REACT
Simple Contact Form Component

Here's a complete React form component:

// File: src/components/ContactForm.jsx

import { useState } from 'react' import './ContactForm.css'

export default function ContactForm() { // ============================================ // STATE MANAGEMENT // ============================================

// State for form inputs const [formData, setFormData] = useState({ name: '', email: '', message: '', subject: '', subscribe: false })

// State for form submission const [submitted, setSubmitted] = useState(false)

// State for errors const [errors, setErrors] = useState({})

// ============================================ // EVENT HANDLERS // ============================================

// Handle input change const handleChange = (e) => { const { name, value, type, checked } = e.target

// For checkboxes, use checked; for others, use value
const inputValue = type === 'checkbox' ? checked : value

// Update specific field in formData
setFormData({
  ...formData,
  [name]: inputValue
})

// Clear error for this field when user starts typing
if (errors[name]) {
  setErrors({
    ...errors,
    [name]: ''
  })
}
}

// Validate form const validateForm = () => { const newErrors = {}

// Validate name
if (!formData.name.trim()) {
  newErrors.name = 'Name is required'
}

// Validate email
if (!formData.email.trim()) {
  newErrors.email = 'Email is required'
} else if (!formData.email.includes('@')) {
  newErrors.email = 'Email must be valid'
}

// Validate message
if (!formData.message.trim()) {
  newErrors.message = 'Message is required'
} else if (formData.message.length < 10) {
  newErrors.message = 'Message must be at least 10 characters'
}

// Validate subject
if (!formData.subject) {
  newErrors.subject = 'Please select a subject'
}

return newErrors
}

// Handle form submission const handleSubmit = (e) => { // Prevent default form submission (page reload) e.preventDefault()

// Validate form
const newErrors = validateForm()

if (Object.keys(newErrors).length === 0) {
  // Form is valid
  console.log('Form submitted:', formData)
  
  // Show success message
  setSubmitted(true)

  // Reset form after 2 seconds
  setTimeout(() => {
    setFormData({
      name: '',
      email: '',
      message: '',
      subject: '',
      subscribe: false
    })
    setSubmitted(false)
  }, 2000)
} else {
  // Form has errors
  setErrors(newErrors)
}
}

// Handle form reset const handleReset = () => { setFormData({ name: '', email: '', message: '', subject: '', subscribe: false }) setErrors({}) }

// ============================================ // RENDER // ============================================

return ( <div className="contact-form-container"> <div className="form-wrapper"> <h1>Contact Us</h1> <p className="form-description"> Fill out the form below and we'll get back to you soon. </p>

    {/* Success Message */}
    {submitted && (
      <div className="alert alert-success">
        <p>✓ Thank you!
Your message has been sent successfully.</p> </div> )}

    {/* Form */}
    <form onSubmit={handleSubmit}>
      
      {/* Name Field */}
      <div className="form-group">
        <label htmlFor="name">Name:</label>
        <input
          id="name"
          type="text"
          name="name"
          value={formData.name}
          onChange={handleChange}
          placeholder="Enter your name"
          className={errors.name ? 'input-error' : ''}
        />
        {errors.name && (
          <p className="error-message">{errors.name}</p>
        )}
      </div>

      {/* Email Field */}
      <div className="form-group">
        <label htmlFor="email">Email:</label>
        <input
          id="email"
          type="email"
          name="email"
          value={formData.email}
          onChange={handleChange}
          placeholder="Enter your email"
          className={errors.email ? 'input-error' : ''}
        />
        {errors.email && (
          <p className="error-message">{errors.email}</p>
        )}
      </div>

      {/* Subject Dropdown */}
      <div className="form-group">
        <label htmlFor="subject">Subject:</label>
        <select
          id="subject"
          name="subject"
          value={formData.subject}
          onChange={handleChange}
          className={errors.subject ? 'input-error' : ''}
        >
          <option value="">Select a subject</option>
          <option value="general">General Inquiry</option>
          <option value="support">Support</option>
          <option value="feedback">Feedback</option>
          <option value="other">Other</option>
        </select>
        {errors.subject && (
          <p className="error-message">{errors.subject}</p>
        )}
      </div>

      {/* Message Textarea */}
      <div className="form-group">
        <label htmlFor="message">Message:</label>
        <textarea
          id="message"
          name="message"
          value={formData.message}
          onChange={handleChange}
          placeholder="Enter your message (minimum 10 characters)"
          rows="5"
          className={errors.message ? 'input-error' : ''}
        ></textarea>
        {errors.message && (
          <p className="error-message">{errors.message}</p>
        )}
      </div>

      {/* Subscribe Checkbox */}
      <div className="form-group checkbox-group">
        <input
          id="subscribe"
          type="checkbox"
          name="subscribe"
          checked={formData.subscribe}
          onChange={handleChange}
        />
        <label htmlFor="subscribe">
          Subscribe to our newsletter
        </label>
      </div>

      {/* Buttons */}
      <div className="button-group">
        <button type="submit" className="btn btn-primary">
          Send Message
        </button>
        <button type="reset" onClick={handleReset} className="btn btn-secondary">
          Clear Form
        </button>
      </div>
    </form>

    {/* Form Data Display (for debugging) */}
    <div className="form-data-display">
      <h3>Current Form Data:</h3>
      <pre>{JSON.stringify(formData, null, 2)}</pre>
    </div>
  </div>
</div>
) }


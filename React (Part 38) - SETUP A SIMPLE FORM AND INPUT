import { useState } from 'react'
import './SimpleForm.css'


export default function SimpleForm() {

  const [formData, setFormData] =
    useState({

      name: '',

      email: ''

    })


  const handleChange = (event) => {

    const {
      name,
      value
    } = event.target


    setFormData(previousData => ({

      ...previousData,

      [name]: value

    }))
  }


  return (
    <div className="simple-form-container">

      <h1>
        Simple Form
      </h1>

      <p>
        Enter your information below:
      </p>


      <form
        className="form"
        onSubmit={(event) =>
          event.preventDefault()
        }
      >


        {/* Name */}

        <div className="form-group">

          <label
            htmlFor="name"
            className="form-label"
          >
            Name:
          </label>


          <input
            id="name"
            type="text"
            name="name"
            value={formData.name}
            onChange={handleChange}
            placeholder="Enter your name"
            className="form-input"
          />

        </div>


        {/* Email */}

        <div className="form-group">

          <label
            htmlFor="email"
            className="form-label"
          >
            Email:
          </label>


          <input
            id="email"
            type="email"
            name="email"
            value={formData.email}
            onChange={handleChange}
            placeholder="Enter your email"
            className="form-input"
          />

        </div>


        {/* Current Values */}

        <div className="form-display">

          <h3>
            Current Values:
          </h3>

          <p>

            Name:
            {' '}

            <strong>
              {formData.name || '(empty)'}
            </strong>

          </p>


          <p>

            Email:
            {' '}

            <strong>
              {formData.email || '(empty)'}
            </strong>

          </p>

        </div>

      </form>

    </div>
  )
}


================================================================================
THREE IMPORTANT INPUT PROPS
================================================================================

INPUT:
--------------------------------------------------------------------------------

<input
  name="name"
  value={formData.name}
  onChange={handleChange}
/>


1. name
--------------------------------------------------------------------------------

name="name"

Identifies which property should be updated.


2. value
--------------------------------------------------------------------------------

value={formData.name}

Makes the rendered input value come from React state.


3. onChange
--------------------------------------------------------------------------------

onChange={handleChange}

Updates state when the user edits the input.


================================================================================
CONTROLLED INPUT
================================================================================

A controlled input follows this pattern:

STATE
  ↓
value={state}
  ↓
INPUT
  ↓
User Types
  ↓
onChange
  ↓
setState
  ↓
NEW STATE
  ↓
RENDER
  ↓
INPUT


Example:

formData.name
     ↓
value={formData.name}
     ↓
Name Input
     ↓
User types "John"
     ↓
handleChange
     ↓
setFormData(...)
     ↓
formData.name = "John"
     ↓
Input renders "John"


================================================================================
INPUT PROPS TABLE
================================================================================

+----------------------------+------------------------------------------+
| PROP                       | PURPOSE                                  |
+----------------------------+------------------------------------------+
| id="name"                  | Connects label with input                |
| htmlFor="name"             | Associates label with input              |
| name="name"                | Maps input to state property             |
| value={formData.name}      | Controlled current value                 |
| onChange={handleChange}    | Processes user input                     |
| type="text"                | Text input                               |
| type="email"               | Email-oriented input                     |
| placeholder="..."          | Optional input hint                      |
+----------------------------+------------------------------------------+


IMPORTANT ABOUT type="email"
--------------------------------------------------------------------------------

type="email" gives the browser email-specific semantics and can participate
in native constraint validation.

It does NOT mean React automatically validates or guarantees a valid email
address while the user types.

Application-specific validation can be added later.



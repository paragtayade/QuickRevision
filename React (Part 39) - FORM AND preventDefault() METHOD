PART 5: FORM WITH VALIDATION AND preventDefault()
================================================================================

File:

src/components/AdvancedForm.jsx


import { useState } from 'react'
import './AdvancedForm.css'


const INITIAL_FORM = {

  name: '',

  email: '',

  message: ''

}


export default function AdvancedForm() {

  // ============================================
  // STATE
  // ============================================

  const [formData, setFormData] =
    useState(INITIAL_FORM)


  const [errors, setErrors] =
    useState({})


  const [submitted, setSubmitted] =
    useState(false)


  const [
    isSubmitting,
    setIsSubmitting
  ] = useState(false)


  // ============================================
  // VALIDATION
  // ============================================

  const validateForm = () => {

    const newErrors = {}


    // Name

    if (!formData.name.trim()) {

      newErrors.name =
        'Name is required'
    }


    // Email

    if (!formData.email.trim()) {

      newErrors.email =
        'Email is required'

    } else if (
      !formData.email.includes('@')
    ) {

      newErrors.email =
        'Enter a valid email address'
    }


    // Message

    if (!formData.message.trim()) {

      newErrors.message =
        'Message is required'

    } else if (
      formData.message.trim().length < 10
    ) {

      newErrors.message =
        'Message must be at least 10 characters'
    }


    return newErrors
  }


  // ============================================
  // CHANGE
  // ============================================

  const handleChange = (event) => {

    const {
      name,
      value
    } = event.target


    setFormData(previousData => ({

      ...previousData,

      value

    }))


    // Clear this field's application error
    // after the user starts correcting it.

    setErrors(previousErrors => {

      if (!previousErrors[name]) {

        return previousErrors
      }


      return {

        ...previousErrors,

        ''

      }
    })
  }


  // ============================================
  // SUBMIT
  // ============================================

  const handleSubmit =
    async (event) => {

      event.preventDefault()


      const validationErrors =
        validateForm()


      if (
        Object.keys(
          validationErrors
        ).length > 0
      ) {

        setErrors(
          validationErrors
        )

        return
      }


      setErrors({})

      setIsSubmitting(true)

      setSubmitted(false)


      try {

        /*
         * Real application:
         *
         * await submitForm(formData)
         *
         * For this educational example,
         * we'll simulate async work.
         */

        await new Promise(resolve => {

          setTimeout(
            resolve,
            1000
          )

        })


        console.log(
          'Submitted data:',
          formData
        )


        setSubmitted(true)


        // Reset controlled fields
        // after successful submission.

        setFormData(
          INITIAL_FORM
        )

      } catch (error) {

        console.error(
          'Submission failed:',
          error
        )

      } finally {

        setIsSubmitting(false)

      }
    }


  // ============================================
  // RESET
  // ============================================

  const handleReset = () => {

    setFormData(
      INITIAL_FORM
    )

    setErrors({})

    setSubmitted(false)
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="advanced-form-container">


      <h1>
        Advanced Form with preventDefault()
      </h1>


      <p>
        Client-side validation and
        custom submission handling
      </p>


      {/* Success */}

      {submitted && (

        <div
          className="success-message"
          role="status"
        >

          <h3>
            Success
          </h3>

          <p>
            The form was processed
            successfully.
          </p>

        </div>

      )}


      {/* Form */}

      <form
        onSubmit={handleSubmit}
        onReset={handleReset}
        className="form"
        noValidate
      >


        {/* Name */}

        <div className="form-group">

          <label htmlFor="name">
            Name:
          </label>


          <input
            id="name"
            type="text"
            name="name"
            value={formData.name}
            onChange={handleChange}
            placeholder="Enter your name"
            className={
              `form-input ${
                errors.name
                  ? 'input-error'
                  : ''
              }`
            }
            aria-invalid={
              Boolean(errors.name)
            }
            aria-describedby={
              errors.name
                ? 'name-error'
                : undefined
            }
          />


          {errors.name && (

            <p
              id="name-error"
              className="error-message"
            >
              {errors.name}
            </p>

          )}

        </div>


        {/* Email */}

        <div className="form-group">

          <label htmlFor="email">
            Email:
          </label>


          <input
            id="email"
            type="email"
            name="email"
            value={formData.email}
            onChange={handleChange}
            placeholder="Enter your email"
            className={
              `form-input ${
                errors.email
                  ? 'input-error'
                  : ''
              }`
            }
            aria-invalid={
              Boolean(errors.email)
            }
            aria-describedby={
              errors.email
                ? 'email-error'
                : undefined
            }
          />


          {errors.email && (

            <p
              id="email-error"
              className="error-message"
            >
              {errors.email}
            </p>

          )}

        </div>


        {/* Message */}

        <div className="form-group">

          <label htmlFor="message">
            Message:
          </label>


          <textarea
            id="message"
            name="message"
            value={formData.message}
            onChange={handleChange}
            placeholder="Enter at least 10 characters"
            className={
              `form-input ${
                errors.message
                  ? 'input-error'
                  : ''
              }`
            }
            rows={5}
            aria-invalid={
              Boolean(errors.message)
            }
            aria-describedby={
              errors.message
                ? 'message-error'
                : undefined
            }
          >
          </textarea>


          {errors.message && (

            <p
              id="message-error"
              className="error-message"
            >
              {errors.message}
            </p>

          )}

        </div>


        {/* Buttons */}

        <div className="button-group">

          <button
            type="submit"
            className="btn-submit"
            disabled={isSubmitting}
          >

            {isSubmitting
              ? 'Submitting...'
              : 'Submit Form'}

          </button>


          <button
            type="reset"
            className="btn-reset"
            disabled={isSubmitting}
          >

            Clear Form

          </button>

        </div>

      </form>


      {/* Information */}

      <div className="info-box">

        <h3>
          Submission Flow:
        </h3>

        <ul>

          <li>
            User submits the form
          </li>

          <li>
            preventDefault() blocks native submission
          </li>

          <li>
            Application validation runs
          </li>

          <li>
            Invalid fields display errors
          </li>

          <li>
            Valid data can be sent asynchronously
          </li>

          <li>
            UI displays the resulting state
          </li>

        </ul>

      </div>


      {/* Debug */}

      <div className="debug-info">

        <h3>
          Current State:
        </h3>


        <div className="debug-section">

          <h4>
            Form Data:
          </h4>

          <pre>
            {JSON.stringify(
              formData,
              null,
              2
            )}
          </pre>

        </div>


        <div className="debug-section">

          <h4>
            Errors:
          </h4>

          <pre>
            {JSON.stringify(
              errors,
              null,
              2
            )}
          </pre>

        </div>

      </div>

    </div>
  )
}



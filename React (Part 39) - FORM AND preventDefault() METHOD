import { useState } from 'react'
import './FormWithPreventDefault.css'


const INITIAL_FORM = {

  name: '',

  email: ''

}


export default function FormWithPreventDefault() {

  // ============================================
  // STATE
  // ============================================

  const [formData, setFormData] =
    useState(INITIAL_FORM)


  const [
    submittedData,
    setSubmittedData
  ] = useState(null)


  // ============================================
  // INPUT HANDLER
  // ============================================

  const handleChange = (event) => {

    const {
      name,
      value
    } = event.target


    setFormData(previousData => ({

      ...previousData,

      value

    }))
  }


  // ============================================
  // SUBMIT HANDLER
  // ============================================

  const handleSubmit = (event) => {

    // Prevent browser's native form submission

    event.preventDefault()


    console.log(
      'Form submitted'
    )


    console.log(
      'Form data:',
      formData
    )


    // Capture submitted values

    setSubmittedData({

      ...formData

    })
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="form-container">


      <h1>
        Form with preventDefault()
      </h1>


      <p>
        This example handles submission
        with React.
      </p>


      {/* Success / Submitted Data */}

      {submittedData && (

        <div className="success-message">

          <h3>
            Form Submitted
          </h3>


          <p>
            Application code handled the
            submit event.
          </p>


          <div className="submitted-data">

            <p>

              <strong>Name:</strong>
              {' '}
              {submittedData.name}

            </p>


            <p>

              <strong>Email:</strong>
              {' '}
              {submittedData.email}

            </p>

          </div>

        </div>

      )}


      {/* Form */}

      <form
        onSubmit={handleSubmit}
        className="form"
      >


        {/* Name */}

        <div className="form-group">

          <label htmlFor="name">
            Name:
          </label>


          <input
            id="name"
            type="text"
            name="name"
            value={formData.name}
            onChange={handleChange}
            placeholder="Enter your name"
            className="form-input"
          />

        </div>


        {/* Email */}

        <div className="form-group">

          <label htmlFor="email">
            Email:
          </label>


          <input
            id="email"
            type="email"
            name="email"
            value={formData.email}
            onChange={handleChange}
            placeholder="Enter your email"
            className="form-input"
          />

        </div>


        {/* Submit */}

        <button
          type="submit"
          className="btn-submit"
        >

          Submit Form

        </button>

      </form>


      {/* Debug */}

      <div className="debug-info">

        <h3>
          Current Form Data:
        </h3>


        <pre>
          {JSON.stringify(
            formData,
            null,
            2
          )}
        </pre>

      </div>

    </div>
  )
}


================================================================================
BASIC SUBMISSION FLOW
================================================================================

Controlled Inputs
      ↓
formData State
      ↓
User Clicks Submit
      ↓
<form onSubmit>
      ↓
handleSubmit(event)
      ↓
event.preventDefault()
      ↓
Native Submit Prevented
      ↓
Read formData
      ↓
Custom Processing
      ↓
React UI Continues


================================================================================
CODE EXPLANATION
================================================================================

+----------------------------+-------------------------------------------+
| CODE                       | PURPOSE                                   |
+----------------------------+-------------------------------------------+
| onSubmit={handleSubmit}    | Handles form submission                  |
| type="submit"              | Creates form submit control              |
| event.preventDefault()     | Prevents default submit action           |
| formData                   | Current input values                     |
| submittedData              | Snapshot of submitted values             |
| setSubmittedData(...)      | Stores data submitted by user            |
+----------------------------+-------------------------------------------+


================================================================================
WHY COPY formData INTO submittedData?
================================================================================

This:

setSubmittedData({
  ...formData
})


creates a snapshot-like object for the submitted values.

That separates:

CURRENT EDITABLE FORM

from:

LAST SUBMITTED VALUES


Example:

Current formData:

{
  name: 'John',
  email: 'john@example.com'
}


After submit:

submittedData:

{
  name: 'John',
  email: 'john@example.com'
}


The user can then continue editing formData without changing the already
captured submitted object.



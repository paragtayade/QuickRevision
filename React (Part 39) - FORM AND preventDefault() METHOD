import {
  render,
  screen
} from '@testing-library/react'

import userEvent
  from '@testing-library/user-event'

import FormWithPreventDefault
  from './FormWithPreventDefault'


test(
  'processes form without native navigation',

  async () => {

    const user =
      userEvent.setup()


    render(
      <FormWithPreventDefault />
    )


    await user.type(
      screen.getByLabelText(/name/i),
      'John'
    )


    await user.type(
      screen.getByLabelText(/email/i),
      'john@example.com'
    )


    await user.click(
      screen.getByRole(
        'button',
        {
          name: /submit form/i
        }
      )
    )


    expect(
      screen.getByText(
        /form submitted/i
      )
    ).toBeInTheDocument()
  }
)



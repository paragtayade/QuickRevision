          <input
            id="option-a"
            type="radio"
            name="choice"
            value="option-a"
            checked={
              choice ===
              'option-a'
            }
            onChange={handleChange}
          />

          <label htmlFor="option-a">
            Option A
          </label>

        </div>


        {/* Option B */}

        <div className="radio-option">

          <input
            id="option-b"
            type="radio"
            name="choice"
            value="option-b"
            checked={
              choice ===
              'option-b'
            }
            onChange={handleChange}
          />

          <label htmlFor="option-b">
            Option B
          </label>

        </div>


        {/* Option C */}

        <div className="radio-option">

          <input
            id="option-c"
            type="radio"
            name="choice"
            value="option-c"
            checked={
              choice ===
              'option-c'
            }
            onChange={handleChange}
          />

          <label htmlFor="option-c">

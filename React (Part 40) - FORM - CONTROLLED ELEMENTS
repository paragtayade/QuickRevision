import { useState } from 'react'
import './ControlledRadio.css'


export default function ControlledRadio() {

  const [choice, setChoice] =
    useState('')


  const handleChange = (event) => {

    setChoice(
      event.target.value
    )
  }


  return (
    <div className="controlled-radio-container">

      <h1>
        Controlled Radio Buttons
      </h1>


      <fieldset className="form-group radio-group">


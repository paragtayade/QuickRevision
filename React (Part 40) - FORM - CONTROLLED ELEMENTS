CONTROLLED CHECKBOX EXAMPLE
================================================================================

File:

src/components/ControlledCheckbox.jsx


import { useState } from 'react'
import './ControlledCheckbox.css'


export default function ControlledCheckbox() {

  const [
    isSubscribed,
    setIsSubscribed
  ] = useState(false)


  const handleChange = (event) => {

    const isChecked =
      event.target.checked


    setIsSubscribed(
      isChecked
    )
  }


  return (
    <div className="controlled-checkbox-container">

      <h1>
        Controlled Checkbox
      </h1>


      <div className="form-group checkbox-group">

        <input
          id="subscribe"
          type="checkbox"
          checked={isSubscribed}
          onChange={handleChange}
          className="form-checkbox"
        />


        <label htmlFor="subscribe">

          Subscribe to newsletter

        </label>

      </div>


      <div className="display-section">

        <h3>
          Current State:
        </h3>


        <p>

          Subscribed:
          {' '}

          <strong>

            {isSubscribed
              ? 'Yes'
              : 'No'}

          </strong>

        </p>


        {isSubscribed && (

          <p className="success-message">

            Thank you for subscribing!

          </p>

        )}

      </div>

    </div>
  )
}


================================================================================
CHECKBOX RULE
================================================================================

WRONG FOR CONTROLLING CHECKED STATE:
--------------------------------------------------------------------------------

<input
  type="checkbox"
  value={isSubscribed}
/>


CORRECT:
--------------------------------------------------------------------------------

<input
  type="checkbox"
  checked={isSubscribed}
  onChange={(event) =>
    setIsSubscribed(
      event.target.checked
    )
  }
/>


MEMORY:

TEXT INPUT
    ↓
value


CHECKBOX
    ↓
checked


================================================================================
CHECKBOX FLOW
================================================================================

State:

isSubscribed = false


        ↓


checked={false}


        ↓


User Checks Box


        ↓


event.target.checked

=
true


        ↓


setIsSubscribed(true)


        ↓


Render


        ↓


checked={true}



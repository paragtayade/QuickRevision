src/components/ControlledTextInput.jsx


import { useState } from 'react'
import './ControlledTextInput.css'


export default function ControlledTextInput() {

  // ============================================
  // STATE
  // ============================================

  const [name, setName] =
    useState('')


  // ============================================
  // HANDLER
  // ============================================

  const handleChange = (event) => {

    const newValue =
      event.target.value


    setName(newValue)


    console.log(
      'Input value:',
      newValue
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="controlled-input-container">

      <h1>
        Controlled Text Input
      </h1>


      <div className="form-group">

        <label htmlFor="name">
          Name:
        </label>


        <input
          id="name"
          type="text"
          value={name}
          onChange={handleChange}
          placeholder="Enter your name"
          className="form-input"
        />

      </div>


      {/* Current Value */}

      <div className="display-section">

        <h3>
          Current Value:
        </h3>


        <p>

          Name:
          {' '}

          <strong>
            {name || '(empty)'}
          </strong>

        </p>


        <p>

          Length:
          {' '}

          <strong>
            {name.length}
          </strong>
          {' '}
          characters

        </p>

      </div>

    </div>
  )
}


================================================================================
WHAT MAKES THE INPUT CONTROLLED?
================================================================================

Two important pieces:

1. VALUE COMES FROM STATE
--------------------------------------------------------------------------------

value={name}


2. USER CHANGES UPDATE STATE
--------------------------------------------------------------------------------

onChange={handleChange}


Handler:

const handleChange = (
  event
) => {

  setName(
    event.target.value
  )
}


================================================================================
CONTROLLED TEXT INPUT FLOW
================================================================================

State:

name = ""


        ↓


Input:

value=""


        ↓


User types:

J


        ↓


event.target.value:

"J"


        ↓


setName("J")


        ↓


Render


        ↓


Input:

value="J"


================================================================================
TEXT INPUT QUICK TABLE
================================================================================

+----------------------+-----------------------------------------------+
| ITEM                 | PURPOSE                                       |
+----------------------+-----------------------------------------------+
| useState('')         | Initial controlled value                      |
| value={name}         | State controls displayed text                 |
| onChange             | Receives user edits                           |
| event.target.value   | Current text from event                       |
| setName(...)         | Requests state update                         |
| name.length          | Derived character count                       |
+----------------------+-----------------------------------------------+



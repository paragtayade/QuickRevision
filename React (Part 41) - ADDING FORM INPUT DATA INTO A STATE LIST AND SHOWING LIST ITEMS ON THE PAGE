import { useState } from 'react'
import './NotesApp.css'


export default function NotesApp() {

  // ============================================
  // FORM STATE
  // ============================================

  const [
    noteTitle,
    setNoteTitle
  ] = useState('')


  const [
    noteContent,
    setNoteContent
  ] = useState('')


  // ============================================
  // LIST STATE
  // ============================================

  const [notes, setNotes] =
    useState([])


  // ============================================
  // EDIT STATE
  // ============================================

  const [
    editingId,
    setEditingId
  ] = useState(null)


  // ============================================
  // SUBMIT
  // ============================================

  const handleSubmit = (
    event
  ) => {

    event.preventDefault()


    const title =
      noteTitle.trim()


    const content =
      noteContent.trim()


    if (
      !title ||
      !content
    ) {

      alert(
        'Please fill in both title and content'
      )

      return
    }


    if (editingId !== null) {

      // UPDATE

      setNotes(previousNotes =>

        previousNotes.map(note =>

          note.id === editingId
            ? {
                ...note,
                title,
                content,
                updatedAt:
                  new Date()
              }
            : note

        )

      )


      setEditingId(null)

    } else {

      // CREATE

      const now =
        new Date()


      const newNote = {

        id:
          crypto.randomUUID(),

        title,

        content,

        createdAt:
          now,

        updatedAt:
          now

      }


      setNotes(previousNotes => [

        newNote,

        ...previousNotes

      ])
    }


    clearForm()
  }


  // ============================================
  // DELETE
  // ============================================

  const handleDelete = (
    id
  ) => {

    setNotes(previousNotes =>

      previousNotes.filter(
        note =>
          note.id !== id
      )

    )


    // If deleting note currently being edited,
    // leave edit mode as well.

    if (editingId === id) {

      clearForm()

      setEditingId(null)
    }
  }


  // ============================================
  // EDIT
  // ============================================

  const handleEdit = (
    note
  ) => {

    setNoteTitle(
      note.title
    )

    setNoteContent(
      note.content
    )

    setEditingId(
      note.id
    )
  }


  // ============================================
  // CANCEL
  // ============================================

  const handleCancelEdit = () => {

    clearForm()

    setEditingId(null)
  }


  // ============================================
  // HELPER
  // ============================================

  function clearForm() {

    setNoteTitle('')

    setNoteContent('')
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="notes-app-container">

      <h1>
        Notes App
      </h1>


      {/* Form */}

      <form
        onSubmit={handleSubmit}
        className="notes-form"
      >

        <div className="form-group">

          <label htmlFor="note-title">
            Title
          </label>

          <input
            id="note-title"
            type="text"
            value={noteTitle}
            onChange={(event) =>
              setNoteTitle(
                event.target.value
              )
            }
            placeholder="Note title"
            className="form-input"
          />

        </div>


        <div className="form-group">

          <label htmlFor="note-content">
            Content
          </label>

          <textarea
            id="note-content"
            value={noteContent}
            onChange={(event) =>
              setNoteContent(
                event.target.value
              )
            }
            placeholder="Note content"
            rows={4}
            className="form-textarea"
          />

        </div>


        <div className="button-group">

          <button
            type="submit"
            className="btn-submit"
          >

            {editingId !== null
              ? 'Update Note'
              : 'Add Note'}

          </button>


          {editingId !== null && (

            <button
              type="button"
              onClick={
                handleCancelEdit
              }
              className="btn-cancel"
            >
              Cancel
            </button>

          )}

        </div>

      </form>


      {/* Count */}

      <div className="notes-count">

        <p>

          Total notes:
          {' '}

          <strong>
            {notes.length}
          </strong>

        </p>

      </div>


      {/* Notes */}

      <div className="notes-list-section">

        {notes.length === 0 ? (

          <p className="empty-message">

            No notes yet.
            Create one to get started!

          </p>

        ) : (

          <div className="notes-grid">

            {notes.map(note => (

              <article
                key={note.id}
                className="note-card"
              >

                <h3 className="note-title">

                  {note.title}

                </h3>


                <p className="note-content">

                  {note.content}

                </p>


                <p className="note-date">

                  Created:
                  {' '}

                  {
                    note.createdAt
                      .toLocaleDateString()
                  }

                </p>


                <div className="note-actions">

                  <button
                    type="button"
                    onClick={() =>
                      handleEdit(note)
                    }
                    className="btn-edit"
                  >
                    Edit
                  </button>


                  <button
                    type="button"
                    onClick={() =>
                      handleDelete(
                        note.id
                      )
                    }
                    className="btn-delete"
                  >
                    Delete
                  </button>

                </div>

              </article>

            ))}

          </div>

        )}

      </div>

    </div>
  )
}


================================================================================
IMPORTANT EDITING CHECK
================================================================================

Avoid relying on:

if (editingId)


because IDs could theoretically contain a falsy value such as:

0


Prefer:

if (editingId !== null)


This clearly expresses:

null
=
not editing


anything else
=
editing that item



import { useState } from 'react'
import './TodoApp.css'


export default function TodoApp() {

  // ============================================
  // STATE
  // ============================================

  const [
    inputValue,
    setInputValue
  ] = useState('')


  const [todos, setTodos] =
    useState([])


  // ============================================
  // INPUT CHANGE
  // ============================================

  const handleInputChange = (
    event
  ) => {

    setInputValue(
      event.target.value
    )
  }


  // ============================================
  // SUBMIT
  // ============================================

  const handleSubmit = (
    event
  ) => {

    event.preventDefault()


    const text =
      inputValue.trim()


    if (!text) {

      alert(
        'Please enter a todo item'
      )

      return
    }


    const newTodo = {

      id:
        crypto.randomUUID(),

      text,

      completed:
        false,

      createdAt:
        new Date()

    }


    setTodos(previousTodos => [

      ...previousTodos,

      newTodo

    ])


    // Clear controlled input

    setInputValue('')


    console.log(
      'Todo added:',
      newTodo
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="todo-app-container">

      <h1>
        Todo App
      </h1>


      <p>
        Add items to your todo list
      </p>


      {/* Form */}

      <form
        onSubmit={handleSubmit}
        className="todo-form"
      >

        <div className="form-group">

          <input
            type="text"
            value={inputValue}
            onChange={
              handleInputChange
            }
            placeholder="Enter a new todo..."
            className="todo-input"
            aria-label="New todo"
          />


          <button
            type="submit"
            className="btn-add"
          >
            Add Todo
          </button>

        </div>

      </form>


      {/* Count */}

      <div className="todo-count">

        <p>

          Total todos:
          {' '}

          <strong>
            {todos.length}
          </strong>

        </p>

      </div>


      {/* List */}

      <div className="todo-list-section">

        {todos.length === 0 ? (

          <p className="empty-message">

            No todos yet.
            Add one to get started!

          </p>

        ) : (

          <ul className="todo-list">

            {todos.map(todo => (

              <li
                key={todo.id}
                className="todo-item"
              >

                <span className="todo-text">

                  {todo.text}

                </span>


                <span className="todo-time">

                  {
                    todo.createdAt
                      .toLocaleTimeString()
                  }

                </span>

              </li>

            ))}

          </ul>

        )}

      </div>


      {/* Debug */}

      <div className="debug-section">

        <h3>
          Current State:
        </h3>

        <pre>

          {JSON.stringify(
            todos,
            null,
            2
          )}

        </pre>

      </div>

    </div>
  )
}



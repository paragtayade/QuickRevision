================================================================================
FORM-TO-LIST COMPLETE PATTERN
================================================================================

const [
  inputValue,
  setInputValue
] = useState('')


const [items, setItems] =
  useState([])


const handleSubmit = (
  event
) => {

  event.preventDefault()


  const text =
    inputValue.trim()


  if (!text) {

    return
  }


  const newItem = {

    id:
      crypto.randomUUID(),

    text

  }


  setItems(previousItems => [

    ...previousItems,

    newItem

  ])


  setInputValue('')
}


return (
  <>

    <form onSubmit={handleSubmit}>

      <input
        value={inputValue}
        onChange={(event) =>
          setInputValue(
            event.target.value
          )
        }
      />


      <button type="submit">

        Add

      </button>

    </form>


    {items.length === 0 ? (

      <p>
        No items yet
      </p>

    ) : (

      <ul>

        {items.map(item => (

          <li key={item.id}>

            {item.text}

          </li>

        ))}

      </ul>

    )}

  </>
)



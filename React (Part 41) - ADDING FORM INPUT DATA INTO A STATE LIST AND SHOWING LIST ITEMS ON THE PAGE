import { useState } from 'react'
import './ShoppingListApp.css'


export default function ShoppingListApp() {

  // ============================================
  // FORM STATE
  // ============================================

  const [
    itemName,
    setItemName
  ] = useState('')


  const [
    quantity,
    setQuantity
  ] = useState('1')


  // ============================================
  // LIST STATE
  // ============================================

  const [items, setItems] =
    useState([])


  // ============================================
  // ADD
  // ============================================

  const handleSubmit = (
    event
  ) => {

    event.preventDefault()


    const name =
      itemName.trim()


    const numericQuantity =
      Number(quantity)


    if (!name) {

      alert(
        'Please enter an item name'
      )

      return
    }


    if (
      !Number.isInteger(
        numericQuantity
      ) ||
      numericQuantity < 1
    ) {

      alert(
        'Quantity must be a positive whole number'
      )

      return
    }


    const newItem = {

      id:
        crypto.randomUUID(),

      name,

      quantity:
        numericQuantity,

      purchased:
        false,

      addedAt:
        new Date()

    }


    setItems(previousItems => [

      ...previousItems,

      newItem

    ])


    setItemName('')

    setQuantity('1')
  }


  // ============================================
  // DELETE
  // ============================================

  const handleDelete = (
    id
  ) => {

    setItems(previousItems =>

      previousItems.filter(
        item =>
          item.id !== id
      )

    )
  }


  // ============================================
  // TOGGLE PURCHASED
  // ============================================

  const handleTogglePurchased = (
    id
  ) => {

    setItems(previousItems =>

      previousItems.map(item =>

        item.id === id
          ? {
              ...item,
              purchased:
                !item.purchased
            }
          : item

      )

    )
  }


  // ============================================
  // DERIVED STATISTICS
  // ============================================

  const purchasedCount =
    items.filter(
      item =>
        item.purchased
    ).length


  const remainingCount =
    items.length -
    purchasedCount


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="shopping-list-container">

      <h1>
        Shopping List
      </h1>


      {/* Form */}

      <form
        onSubmit={handleSubmit}
        className="shopping-form"
      >

        <div className="form-group">

          <input
            type="text"
            value={itemName}
            onChange={(event) =>
              setItemName(
                event.target.value
              )
            }
            placeholder="Item name"
            className="form-input"
            aria-label="Item name"
          />


          <input
            type="number"
            value={quantity}
            onChange={(event) =>
              setQuantity(
                event.target.value
              )
            }
            min="1"
            step="1"
            className="form-input quantity-input"
            aria-label="Quantity"
          />


          <button
            type="submit"
            className="btn-add"
          >
            Add Item
          </button>

        </div>

      </form>


      {/* Statistics */}

      <div className="stats">

        <p>
          Total:
          {' '}
          <strong>
            {items.length}
          </strong>
        </p>


        <p>
          Purchased:
          {' '}
          <strong>
            {purchasedCount}
          </strong>
        </p>


        <p>
          Remaining:
          {' '}
          <strong>
            {remainingCount}
          </strong>
        </p>

      </div>


      {/* List */}

      <div className="shopping-list-section">

        {items.length === 0 ? (

          <p className="empty-message">

            Your shopping list is empty.

          </p>

        ) : (

          <ul className="shopping-list">

            {items.map(item => (

              <li
                key={item.id}
                className={
                  `shopping-item ${
                    item.purchased
                      ? 'purchased'
                      : ''
                  }`
                }
              >

                <div className="item-content">

                  <input
                    type="checkbox"
                    checked={
                      item.purchased
                    }
                    onChange={() =>
                      handleTogglePurchased(
                        item.id
                      )
                    }
                    aria-label={
                      `Mark ${item.name} as ${
                        item.purchased
                          ? 'not purchased'
                          : 'purchased'
                      }`
                    }
                  />


                  <span className="item-name">

                    {item.name}

                  </span>


                  <span className="item-quantity">

                    ×{item.quantity}

                  </span>

                </div>


                <button
                  type="button"
                  onClick={() =>
                    handleDelete(
                      item.id
                    )
                  }
                  className="btn-delete"
                >
                  Delete
                </button>

              </li>

            ))}

          </ul>

        )}

      </div>

    </div>
  )
}



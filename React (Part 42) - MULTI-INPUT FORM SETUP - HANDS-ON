PART 5: MULTI-INPUT FORM WITH VALIDATION
================================================================================

A larger form usually needs:

FORM DATA
    +
ERROR STATE
    +
VALIDATION
    +
SUBMISSION STATE


================================================================================
INITIAL FORM
================================================================================

const INITIAL_FORM = {

  firstName: '',

  lastName: '',

  email: '',

  phone: '',

  password: '',

  confirmPassword: '',

  country: '',

  agreeTerms: false

}


================================================================================
STATE
================================================================================

const [formData, setFormData] =
  useState(INITIAL_FORM)


const [errors, setErrors] =
  useState({})


const [submitted, setSubmitted] =
  useState(false)


================================================================================
VALIDATION FUNCTION
================================================================================

const validateForm = () => {

  const newErrors = {}


  // First Name

  if (
    !formData.firstName.trim()
  ) {

    newErrors.firstName =
      'First name is required'
  }


  // Last Name

  if (
    !formData.lastName.trim()
  ) {

    newErrors.lastName =
      'Last name is required'
  }


  // Email

  if (
    !formData.email.trim()
  ) {

    newErrors.email =
      'Email is required'

  } else if (
    !formData.email.includes('@')
  ) {

    newErrors.email =
      'Enter a valid email address'
  }


  // Phone

  const phoneDigits =
    formData.phone
      .replace(/\D/g, '')


  if (
    !formData.phone.trim()
  ) {

    newErrors.phone =
      'Phone is required'

  } else if (
    phoneDigits.length < 10
  ) {

    newErrors.phone =
      'Enter at least 10 digits'
  }


  // Password

  if (!formData.password) {

    newErrors.password =
      'Password is required'

  } else if (
    formData.password.length < 8
  ) {

    newErrors.password =
      'Password must be at least 8 characters'
  }


  // Confirmation

  if (
    !formData.confirmPassword
  ) {

    newErrors.confirmPassword =
      'Confirm your password'

  } else if (
    formData.password !==
    formData.confirmPassword
  ) {

    newErrors.confirmPassword =
      'Passwords do not match'
  }


  // Country

  if (!formData.country) {

    newErrors.country =
      'Country is required'
  }


  // Terms

  if (!formData.agreeTerms) {

    newErrors.agreeTerms =
      'You must agree before continuing'
  }


  return newErrors
}


================================================================================
IMPORTANT VALIDATION NOTE
================================================================================

The validation above is instructional.

For a real application:

• Email rules may require more deliberate validation

• Phone formats differ internationally

• Password requirements should follow the actual product/security policy

• Client-side validation must not replace server-side validation for
  security-sensitive data


================================================================================
GENERIC CHANGE HANDLER + ERROR CLEARING
================================================================================

const handleChange = (
  event
) => {

  const {
    name,
    value,
    type,
    checked
  } = event.target


  const nextValue =
    type === 'checkbox'
      ? checked
      : value


  setFormData(previousData => ({

    ...previousData,

    nextValue

  }))


  setErrors(previousErrors => {

    if (
      !previousErrors[name]
    ) {

      return previousErrors
    }


    return {

      ...previousErrors,

      ''

    }
  })
}


================================================================================
SUBMISSION
================================================================================

const handleSubmit = (
  event
) => {

  event.preventDefault()


  const validationErrors =
    validateForm()


  if (
    Object.keys(
      validationErrors
    ).length > 0
  ) {

    setErrors(
      validationErrors
    )

    setSubmitted(false)

    return
  }


  setErrors({})


  console.log(
    'Valid form submitted'
  )


  /*
   * Avoid logging passwords or other
   * sensitive form values.
   */


  setSubmitted(true)
}


================================================================================
RESET
================================================================================

const handleReset = () => {

  setFormData(
    INITIAL_FORM
  )

  setErrors({})

  setSubmitted(false)
}


Use:

<form
  onSubmit={handleSubmit}
  onReset={handleReset}
>


and:

<button type="reset">
  Clear
</button>



/* ============================================
   CONTAINER
   ============================================ */

.advanced-multi-form-container {

  max-width: 900px;

  margin: 0 auto;

  padding: 30px;

  background:
    linear-gradient(
      135deg,
      #667eea 0%,
      #764ba2 100%
    );

  border-radius: 12px;

  box-shadow:
    0 10px 30px
    rgba(0, 0, 0, 0.2);
}


.advanced-multi-form-container h1 {

  color: white;

  text-align: center;

  margin-bottom: 30px;
}


/* ============================================
   SUCCESS
   ============================================ */

.success-message {

  background:
    #4caf50;

  color: white;

  padding: 20px;

  border-radius: 8px;

  margin-bottom: 20px;

  animation:
    slideIn
    0.3s
    ease;
}


/* ============================================
   FORM
   ============================================ */

.form {

  background:
    white;

  padding: 30px;

  border-radius: 8px;

  box-shadow:
    0 5px 15px
    rgba(0, 0, 0, 0.1);
}


/* ============================================
   FIELDSET
   ============================================ */

.form-section {

  margin-bottom: 30px;

  padding: 20px;

  border:
    2px solid #ddd;

  border-radius: 8px;

  background:
    #f9f9f9;
}


.form-section legend {

  font-size: 1.1rem;

  font-weight: 600;

  color: #333;

  padding:
    0 10px;
}


/* ============================================
   ROW
   ============================================ */

.form-row {

  display: grid;

  grid-template-columns:
    repeat(
      auto-fit,
      minmax(
        220px,
        1fr
      )
    );

  gap: 20px;

  margin-bottom: 20px;
}


/* ============================================
   GROUP
   ============================================ */

.form-group {

  display: flex;

  flex-direction: column;
}


.form-group label {

  font-weight: 600;

  color: #333;

  margin-bottom: 8px;
}


/* ============================================
   INPUT
   ============================================ */

.form-input {

  padding:
    12px 15px;

  border:
    2px solid #ddd;

  border-radius: 6px;

  font-size: 1rem;

  font-family: inherit;

  transition:
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    background-color 0.3s ease;
}


.form-input:focus {

  outline: none;

  border-color:
    #667eea;

  box-shadow:
    0 0 0 3px
    rgba(102, 126, 234, 0.15);

  background-color:
    #f8f9ff;
}


/* ============================================
   ERROR
   ============================================ */

.form-input.input-error {

  border-color:
    #f44336;

  background-color:
    #ffebee;
}


.error-message {

  color:
    #b71c1c;

  font-size:
    0.85rem;

  margin-top:
    5px;

  font-weight:
    500;
}


/* ============================================
   CHECKBOX
   ============================================ */

.checkbox-group {

  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 15px;
}


.checkbox-group input {

  cursor: pointer;

  width: 18px;

  height: 18px;
}


/* ============================================
   BUTTONS
   ============================================ */

.button-group {

  display: flex;

  gap: 15px;

  margin-top: 30px;
}


.btn-submit,
.btn-reset {

  flex: 1;

  padding:
    12px 20px;

  border: none;

  border-radius: 6px;

  font-weight: 600;

  cursor: pointer;

  font-size: 1rem;
}


.btn-submit {

  background:
    #667eea;

  color: white;
}


.btn-reset {

  background:
    #f44336;

  color: white;
}


/* ============================================
   DISPLAY
   ============================================ */

.display-section {

  background:
    #f5f5f5;

  padding: 20px;

  border-radius: 8px;

  margin-top: 30px;
}


.display-section pre {

  background:
    #2d2d2d;

  color:
    #f8f8f2;

  padding: 15px;

  border-radius: 4px;

  overflow-x: auto;
}


/* ============================================
   ERROR SUMMARY
   ============================================ */

.errors-section {

  background:
    #ffebee;

  border-left:
    4px solid #f44336;

  padding: 20px;

  border-radius: 8px;

  margin-top: 20px;
}


/* ============================================
   INFO
   ============================================ */

.info-box {

  background:
    #e8f5e9;

  border-left:
    4px solid #4caf50;

  padding: 20px;

  border-radius: 6px;

  margin-top: 20px;
}


/* ============================================
   ANIMATION
   ============================================ */

@keyframes slideIn {

  from {

    opacity: 0;

    transform:
      translateY(-10px);
  }


  to {

    opacity: 1;

    transform:
      translateY(0);
  }

}


/* ============================================
   RESPONSIVE
   ============================================ */

@media (max-width: 768px) {

  .advanced-multi-form-container {

    padding: 20px;
  }


  .form {

    padding: 20px;
  }


  .form-section {

    padding: 15px;
  }


  .form-row {

    grid-template-columns:
      1fr;
  }


  .button-group {

    flex-direction:
      column;
  }

}



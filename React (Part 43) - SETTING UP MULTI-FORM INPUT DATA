================================================================================
INITIAL FORM
================================================================================

const INITIAL_FORM = {

  // Personal

  firstName: '',

  lastName: '',

  email: '',

  phone: '',

  dateOfBirth: '',


  // Address

  street: '',

  city: '',

  state: '',

  zipCode: '',

  country: '',


  // Account

  username: '',

  password: '',

  confirmPassword: '',


  // Preferences

  newsletter: false,

  notifications: true,

  privacy: false

}


================================================================================
STATE
================================================================================

const [formData, setFormData] =
  useState(INITIAL_FORM)


const [errors, setErrors] =
  useState({})


const [submitted, setSubmitted] =
  useState(false)


================================================================================
VALIDATION
================================================================================

const validateForm = () => {

  const newErrors = {}


  // First Name

  if (
    !formData.firstName.trim()
  ) {

    newErrors.firstName =
      'First name is required'
  }


  // Last Name

  if (
    !formData.lastName.trim()
  ) {

    newErrors.lastName =
      'Last name is required'
  }


  // Email

  if (
    !formData.email.trim()
  ) {

    newErrors.email =
      'Email is required'

  } else if (
    !formData.email.includes('@')
  ) {

    newErrors.email =
      'Enter a valid email address'
  }


  // Phone

  const phoneDigits =
    formData.phone
      .replace(/\D/g, '')


  if (
    !formData.phone.trim()
  ) {

    newErrors.phone =
      'Phone is required'

  } else if (
    phoneDigits.length < 10
  ) {

    newErrors.phone =
      'Enter at least 10 digits'
  }


  // Street

  if (
    !formData.street.trim()
  ) {

    newErrors.street =
      'Street is required'
  }


  // City

  if (
    !formData.city.trim()
  ) {

    newErrors.city =
      'City is required'
  }


  // Postal Code

  if (
    !formData.zipCode.trim()
  ) {

    newErrors.zipCode =
      'Postal code is required'
  }


  // Username

  if (
    !formData.username.trim()
  ) {

    newErrors.username =
      'Username is required'

  } else if (
    formData.username
      .trim()
      .length < 3
  ) {

    newErrors.username =
      'Username must be at least 3 characters'
  }


  // Password

  if (!formData.password) {

    newErrors.password =
      'Password is required'

  } else if (
    formData.password.length < 8
  ) {

    newErrors.password =
      'Password must be at least 8 characters'
  }


  // Confirm Password

  if (
    !formData.confirmPassword
  ) {

    newErrors.confirmPassword =
      'Confirm your password'

  } else if (
    formData.password !==
    formData.confirmPassword
  ) {

    newErrors.confirmPassword =
      'Passwords do not match'
  }


  // Privacy

  if (!formData.privacy) {

    newErrors.privacy =
      'You must agree before continuing'
  }


  return newErrors
}


================================================================================
GENERIC CHANGE HANDLER
================================================================================

const handleChange = (
  event
) => {

  const {
    name,
    value,
    type,
    checked
  } = event.target


  const nextValue =
    type === 'checkbox'
      ? checked
      : value


  setFormData(previousData => ({

    ...previousData,

    nextValue

  }))


  // Remove old error for this field
  // while the user is correcting it.

  setErrors(previousErrors => {

    if (
      !previousErrors[name]
    ) {

      return previousErrors
    }


    return {

      ...previousErrors,

      ''

    }
  })
}


================================================================================
SUBMIT HANDLER
================================================================================

const handleSubmit = (
  event
) => {

  event.preventDefault()


  const newErrors =
    validateForm()


  if (
    Object.keys(
      newErrors
    ).length > 0
  ) {

    setErrors(
      newErrors
    )

    setSubmitted(false)

    return
  }


  setErrors({})


  /*
   * Do not log passwords or other
   * sensitive form information.
   *
   * Real application:
   * send an appropriate payload
   * through the application's API.
   */


  setSubmitted(true)
}


================================================================================
RESET HANDLER
================================================================================

const handleReset = () => {

  setFormData(
    INITIAL_FORM
  )

  setErrors({})

  setSubmitted(false)
}


Use:

<form
  onSubmit={handleSubmit}
  onReset={handleReset}
>


and:

<button type="reset">
  Clear
</button>


There is normally no need to call:

preventDefault()

merely to reset controlled React fields.



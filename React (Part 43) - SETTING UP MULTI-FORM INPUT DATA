================================================================================
PATTERN 5: DYNAMIC FIELDS
================================================================================

For dynamic repeated controls, an array may be more natural.


Example:

const [
  fields,
  setFields
] = useState([

  {
    id:
      crypto.randomUUID(),

    label:
      '',

    value:
      ''
  }

])


ADD:
--------------------------------------------------------------------------------

const handleAddField = () => {

  setFields(previous => [

    ...previous,

    {
      id:
        crypto.randomUUID(),

      label:
        '',

      value:
        ''
    }

  ])
}


REMOVE:
--------------------------------------------------------------------------------

const handleRemoveField = (
  id
) => {

  setFields(previous =>

    previous.filter(
      field =>
        field.id !== id
    )

  )
}


UPDATE:
--------------------------------------------------------------------------------

const handleFieldChange = (
  id,
  updates
) => {

  setFields(previous =>

    previous.map(field =>

      field.id === id
        ? {
            ...field,
            ...updates
          }
        : field

    )

  )
}



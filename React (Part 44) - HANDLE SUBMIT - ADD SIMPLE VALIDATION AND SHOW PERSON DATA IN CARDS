import {
  render,
  screen
} from '@testing-library/react'

import userEvent
  from '@testing-library/user-event'

import PersonFormWithCard
  from './PersonFormWithCard'


test(
  'adds a person card after valid submission',

  async () => {

    const user =
      userEvent.setup()


    render(
      <PersonFormWithCard />
    )


    await user.type(
      screen.getByLabelText(
        /first name/i
      ),
      'John'
    )


    await user.type(
      screen.getByLabelText(
        /last name/i
      ),
      'Smith'
    )


    await user.type(
      screen.getByLabelText(
        /email/i
      ),
      'john@example.com'
    )


    await user.type(
      screen.getByLabelText(
        /phone/i
      ),
      '9876543210'
    )


    await user.type(
      screen.getByLabelText(
        /age/i
      ),
      '35'
    )


    await user.click(
      screen.getByRole(
        'button',
        {
          name:
            /register person/i
        }
      )
    )


    expect(
      screen.getByText(
        'John Smith'
      )
    ).toBeInTheDocument()
  }
)



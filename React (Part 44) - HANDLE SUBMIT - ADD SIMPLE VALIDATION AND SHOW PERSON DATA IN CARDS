================================================================================
CRITICAL SUBMISSION POINTS
================================================================================

1. PREVENT NATIVE SUBMISSION
--------------------------------------------------------------------------------

event.preventDefault()


2. VALIDATE
--------------------------------------------------------------------------------

const validationErrors =
  validatePersonForm(
    formData
  )


3. STOP IF INVALID
--------------------------------------------------------------------------------

if (
  Object.keys(
    validationErrors
  ).length > 0
) {

  setErrors(
    validationErrors
  )

  return
}


4. NORMALIZE VALID DATA
--------------------------------------------------------------------------------

const newPerson = {

  id:
    crypto.randomUUID(),

  firstName:
    formData.firstName.trim(),

  lastName:
    formData.lastName.trim(),

  email:
    formData.email
      .trim()
      .toLowerCase(),

  phone:
    formData.phone.trim(),

  age:
    Number(formData.age)

}


5. ADD IMMUTABLY
--------------------------------------------------------------------------------

setPeople(previous => [

  newPerson,

  ...previous

])


6. RESET
--------------------------------------------------------------------------------

setFormData(
  INITIAL_FORM
)


setErrors({})


7. RENDER
--------------------------------------------------------------------------------

people.map(person => (

  <PersonCard
    key={person.id}
    person={person}
    onDelete={
      handleDeletePerson
    }
  />

))



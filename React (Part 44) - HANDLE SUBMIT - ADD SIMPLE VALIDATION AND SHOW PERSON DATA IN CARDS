export function validatePersonForm(
  formData
) {

  const newErrors = {}


  const firstName =
    formData.firstName.trim()


  const lastName =
    formData.lastName.trim()


  const email =
    formData.email.trim()


  const phone =
    formData.phone.trim()


  const phoneDigits =
    phone.replace(/\D/g, '')


  const numericAge =
    Number(formData.age)


  // ============================================
  // FIRST NAME
  // ============================================

  if (!firstName) {

    newErrors.firstName =
      'First name is required'

  } else if (
    firstName.length < 2
  ) {

    newErrors.firstName =
      'First name must contain at least 2 characters'

  } else if (
    firstName.length > 50
  ) {

    newErrors.firstName =
      'First name must not exceed 50 characters'
  }


  // ============================================
  // LAST NAME
  // ============================================

  if (!lastName) {

    newErrors.lastName =
      'Last name is required'

  } else if (
    lastName.length < 2
  ) {

    newErrors.lastName =
      'Last name must contain at least 2 characters'

  } else if (
    lastName.length > 50
  ) {

    newErrors.lastName =
      'Last name must not exceed 50 characters'
  }


  // ============================================
  // EMAIL
  // ============================================

  if (!email) {

    newErrors.email =
      'Email is required'

  } else if (
    !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(
      email
    )
  ) {

    newErrors.email =
      'Enter a valid email address'

  } else if (
    email.length > 100
  ) {

    newErrors.email =
      'Email must not exceed 100 characters'
  }


  // ============================================
  // PHONE
  // ============================================

  if (!phone) {

    newErrors.phone =
      'Phone is required'

  } else if (
    phoneDigits.length < 10
  ) {

    newErrors.phone =
      'Phone must contain at least 10 digits'

  } else if (
    phoneDigits.length > 15
  ) {

    newErrors.phone =
      'Phone must not contain more than 15 digits'
  }


  // ============================================
  // AGE
  // ============================================

  if (
    formData.age === ''
  ) {

    newErrors.age =
      'Age is required'

  } else if (
    !Number.isInteger(
      numericAge
    )
  ) {

    newErrors.age =
      'Age must be a whole number'

  } else if (
    numericAge < 18
  ) {

    newErrors.age =
      'Age must be at least 18'

  } else if (
    numericAge > 120
  ) {

    newErrors.age =
      'Age must not exceed 120'
  }


  return newErrors
}


================================================================================
VALIDATION RULES
================================================================================

+------------+-------------------------------+------------------------------+
| FIELD      | RULE                          | ERROR                        |
+------------+-------------------------------+------------------------------+
| First Name | Required                      | First name is required       |
|            | Minimum 2 characters          | At least 2 characters        |
|            | Maximum 50 characters         | Must not exceed 50           |
| Last Name  | Required                      | Last name is required        |
|            | Minimum 2 characters          | At least 2 characters        |
|            | Maximum 50 characters         | Must not exceed 50           |
| Email      | Required                      | Email is required            |
|            | Basic email structure         | Enter a valid email          |
|            | Maximum 100 characters        | Must not exceed 100          |
| Phone      | Required                      | Phone is required            |
|            | Minimum 10 digits             | At least 10 digits           |
|            | Maximum 15 digits             | No more than 15 digits       |
| Age        | Required                      | Age is required              |
|            | Whole number                  | Must be a whole number       |
|            | Minimum 18                    | Must be at least 18          |
|            | Maximum 120                   | Must not exceed 120          |
+------------+-------------------------------+------------------------------+


IMPORTANT:
--------------------------------------------------------------------------------

These are instructional validation rules.

Real applications may require:

• Different age policies

• Country-aware phone validation

• Product-specific name rules

• More deliberate email handling

• Backend validation

• Duplicate-record checks


Client-side validation improves user experience.

It does NOT replace server-side validation.



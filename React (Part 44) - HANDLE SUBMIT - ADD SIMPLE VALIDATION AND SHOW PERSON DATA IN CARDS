import { useState } from 'react'

import PersonCard
  from './PersonCard'

import {
  validatePersonForm
} from '../utils/personValidation'

import './PersonFormWithCard.css'


const INITIAL_FORM = {

  firstName: '',

  lastName: '',

  email: '',

  phone: '',

  age: ''

}


export default function PersonFormWithCard() {

  // ============================================
  // STATE
  // ============================================

  const [formData, setFormData] =
    useState(INITIAL_FORM)


  const [errors, setErrors] =
    useState({})


  const [people, setPeople] =
    useState([])


  const [
    submissionMessage,
    setSubmissionMessage
  ] = useState('')


  // ============================================
  // INPUT CHANGE
  // ============================================

  const handleChange = (
    event
  ) => {

    const {
      name,
      value
    } = event.target


    setFormData(previousData => ({

      ...previousData,

      value

    }))


    // Clear the old error for this field
    // while the user is correcting it.

    setErrors(previousErrors => {

      if (
        !previousErrors[name]
      ) {

        return previousErrors
      }


      return {

        ...previousErrors,

        ''

      }
    })


    setSubmissionMessage('')
  }


  // ============================================
  // SUBMIT
  // ============================================

  const handleSubmit = (
    event
  ) => {

    event.preventDefault()


    const validationErrors =
      validatePersonForm(
        formData
      )


    if (
      Object.keys(
        validationErrors
      ).length > 0
    ) {

      setErrors(
        validationErrors
      )

      setSubmissionMessage('')

      return
    }


    // Normalize submitted values.

    const newPerson = {

      id:
        crypto.randomUUID(),

      firstName:
        formData.firstName.trim(),

      lastName:
        formData.lastName.trim(),

      email:
        formData.email
          .trim()
          .toLowerCase(),

      phone:
        formData.phone.trim(),

      age:
        Number(formData.age)

    }


    setPeople(previousPeople => [

      newPerson,

      ...previousPeople

    ])


    setFormData(
      INITIAL_FORM
    )


    setErrors({})


    setSubmissionMessage(
      'Person registered successfully.'
    )
  }


  // ============================================
  // DELETE
  // ============================================

  const handleDeletePerson = (
    id
  ) => {

    setPeople(previousPeople =>

      previousPeople.filter(
        person =>
          person.id !== id
      )

    )
  }


  // ============================================
  // RESET
  // ============================================

  const handleReset = () => {

    setFormData(
      INITIAL_FORM
    )

    setErrors({})

    setSubmissionMessage('')
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="person-form-container">

      <h1>
        Person Registration Form
      </h1>


      <p>
        Fill in the form to register a person
      </p>


      {submissionMessage && (

        <p
          className="success-message"
          role="status"
        >
          {submissionMessage}
        </p>

      )}


      <div className="content-wrapper">


        {/* ======================================
            FORM
            ====================================== */}

        <section className="form-section">

          <h2>
            Person Details
          </h2>


          <form
            onSubmit={handleSubmit}
            onReset={handleReset}
            className="form"
            noValidate
          >


            {/* First Name */}

            <div className="form-group">

              <label htmlFor="firstName">
                First Name:
              </label>


              <input
                id="firstName"
                type="text"
                name="firstName"
                value={
                  formData.firstName
                }
                onChange={handleChange}
                placeholder="Enter first name"
                className={
                  `form-input ${
                    errors.firstName
                      ? 'input-error'
                      : ''
                  }`
                }
                aria-invalid={
                  Boolean(
                    errors.firstName
                  )
                }
                aria-describedby={
                  errors.firstName
                    ? 'firstName-error'
                    : undefined
                }
              />


              {errors.firstName && (

                <p
                  id="firstName-error"
                  className="error-message"
                >
                  {errors.firstName}
                </p>

              )}

            </div>


            {/* Last Name */}

            <div className="form-group">

              <label htmlFor="lastName">
                Last Name:
              </label>


              <input
                id="lastName"
                type="text"
                name="lastName"
                value={
                  formData.lastName
                }
                onChange={handleChange}
                placeholder="Enter last name"
                className={
                  `form-input ${
                    errors.lastName
                      ? 'input-error'
                      : ''
                  }`
                }
                aria-invalid={
                  Boolean(
                    errors.lastName
                  )
                }
                aria-describedby={
                  errors.lastName
                    ? 'lastName-error'
                    : undefined
                }
              />


              {errors.lastName && (

                <p
                  id="lastName-error"
                  className="error-message"
                >
                  {errors.lastName}
                </p>

              )}

            </div>


            {/* Email */}

            <div className="form-group">

              <label htmlFor="email">
                Email:
              </label>


              <input
                id="email"
                type="email"
                name="email"
                value={
                  formData.email
                }
                onChange={handleChange}
                placeholder="Enter email"
                className={
                  `form-input ${
                    errors.email
                      ? 'input-error'
                      : ''
                  }`
                }
                aria-invalid={
                  Boolean(
                    errors.email
                  )
                }
                aria-describedby={
                  errors.email
                    ? 'email-error'
                    : undefined
                }
              />


              {errors.email && (

                <p
                  id="email-error"
                  className="error-message"
                >
                  {errors.email}
                </p>

              )}

            </div>


            {/* Phone */}

            <div className="form-group">

              <label htmlFor="phone">
                Phone:
              </label>


              <input
                id="phone"
                type="tel"
                name="phone"
                value={
                  formData.phone
                }
                onChange={handleChange}
                placeholder="Enter phone number"
                className={
                  `form-input ${
                    errors.phone
                      ? 'input-error'
                      : ''
                  }`
                }
                aria-invalid={
                  Boolean(
                    errors.phone
                  )
                }
                aria-describedby={
                  errors.phone
                    ? 'phone-error'
                    : undefined
                }
              />


              {errors.phone && (

                <p
                  id="phone-error"
                  className="error-message"
                >
                  {errors.phone}
                </p>

              )}

            </div>


            {/* Age */}

            <div className="form-group">

              <label htmlFor="age">
                Age:
              </label>


              <input
                id="age"
                type="number"
                name="age"
                value={
                  formData.age
                }
                onChange={handleChange}
                placeholder="Enter age"
                min="18"
                max="120"
                step="1"
                className={
                  `form-input ${
                    errors.age
                      ? 'input-error'
                      : ''
                  }`
                }
                aria-invalid={
                  Boolean(
                    errors.age
                  )
                }
                aria-describedby={
                  errors.age
                    ? 'age-error'
                    : undefined
                }
              />


              {errors.age && (

                <p
                  id="age-error"
                  className="error-message"
                >
                  {errors.age}
                </p>

              )}

            </div>


            {/* Buttons */}

            <div className="button-group">

              <button
                type="submit"
                className="btn-submit"
              >
                Register Person
              </button>


              <button
                type="reset"
                className="btn-reset"
              >
                Clear Form
              </button>

            </div>

          </form>

        </section>


        {/* ======================================
            PERSON CARDS
            ====================================== */}

        <section className="cards-section">

          <h2>

            Registered People
            {' '}
            ({people.length})

          </h2>


          {people.length === 0 ? (

            <p className="empty-message">

              No people registered yet.
              Fill in the form to add one.

            </p>

          ) : (

            <div className="cards-grid">

              {people.map(person => (

                <PersonCard
                  key={person.id}
                  person={person}
                  onDelete={
                    handleDeletePerson
                  }
                />

              ))}

            </div>

          )}

        </section>

      </div>


      {/* Educational Debug Output */}

      <details className="debug-section">

        <summary>
          View current form state
        </summary>

        <pre>
          {JSON.stringify(
            formData,
            null,
            2
          )}
        </pre>

      </details>

    </div>
  )
}



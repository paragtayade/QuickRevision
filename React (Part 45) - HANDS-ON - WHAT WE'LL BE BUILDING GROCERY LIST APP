src/components/GroceryListApp.jsx


import { useState } from 'react'

import './GroceryListApp.css'


const CATEGORIES = [

  'Produce',

  'Dairy',

  'Bakery',

  'Meat',

  'Frozen',

  'Pantry',

  'Beverages'

]


const INITIAL_FORM = {

  name: '',

  quantity: '1',

  category: 'Produce',

  price: '0'

}


const INITIAL_ITEMS = [

  {
    id:
      crypto.randomUUID(),

    name:
      'Milk',

    quantity:
      2,

    category:
      'Dairy',

    price:
      3.99,

    purchased:
      false,

    createdAt:
      new Date().toISOString()
  },


  {
    id:
      crypto.randomUUID(),

    name:
      'Bread',

    quantity:
      1,

    category:
      'Bakery',

    price:
      2.50,

    purchased:
      false,

    createdAt:
      new Date().toISOString()
  }

]


export default function GroceryListApp() {

  // ============================================
  // STATE
  // ============================================

  const [items, setItems] =
    useState(INITIAL_ITEMS)


  const [formData, setFormData] =
    useState(INITIAL_FORM)


  const [filter, setFilter] =
    useState('ALL')


  const [
    editingId,
    setEditingId
  ] = useState(null)


  const [
    formError,
    setFormError
  ] = useState('')


  // ============================================
  // FORM CHANGE
  // ============================================

  const handleFormChange = (
    event
  ) => {

    const {
      name,
      value
    } = event.target


    setFormData(previousData => ({

      ...previousData,

      value

    }))


    setFormError('')
  }


  // ============================================
  // VALIDATION
  // ============================================

  const validateForm = () => {

    const name =
      formData.name.trim()


    const quantity =
      Number(formData.quantity)


    const price =
      Number(formData.price)


    if (!name) {

      return 'Please enter an item name'
    }


    if (
      !Number.isInteger(quantity) ||
      quantity < 1
    ) {

      return 'Quantity must be a positive whole number'
    }


    if (
      formData.price === '' ||
      !Number.isFinite(price) ||
      price < 0
    ) {

      return 'Price must be zero or greater'
    }


    if (
      !CATEGORIES.includes(
        formData.category
      )
    ) {

      return 'Please select a valid category'
    }


    return ''
  }


  // ============================================
  // SUBMIT - ADD OR UPDATE
  // ============================================

  const handleSubmit = (
    event
  ) => {

    event.preventDefault()


    const validationError =
      validateForm()


    if (validationError) {

      setFormError(
        validationError
      )

      return
    }


    const normalizedValues = {

      name:
        formData.name.trim(),

      quantity:
        Number(
          formData.quantity
        ),

      category:
        formData.category,

      price:
        Number(
          formData.price
        )

    }


    if (editingId !== null) {

      // UPDATE ITEM

      setItems(previousItems =>

        previousItems.map(item =>

          item.id === editingId
            ? {
                ...item,
                ...normalizedValues
              }
            : item

        )

      )

    } else {

      // ADD ITEM

      const newItem = {

        id:
          crypto.randomUUID(),

        ...normalizedValues,

        purchased:
          false,

        createdAt:
          new Date()
            .toISOString()

      }


      setItems(previousItems => [

        newItem,

        ...previousItems

      ])
    }


    resetEditor()
  }


  // ============================================
  // EDIT
  // ============================================

  const handleEditItem = (
    item
  ) => {

    setFormData({

      name:
        item.name,

      quantity:
        String(
          item.quantity
        ),

      category:
        item.category,

      price:
        String(
          item.price
        )

    })


    setEditingId(
      item.id
    )


    setFormError('')
  }


  // ============================================
  // CANCEL EDIT
  // ============================================

  const handleCancelEdit = () => {

    resetEditor()
  }


  // ============================================
  // DELETE
  // ============================================

  const handleDeleteItem = (
    id
  ) => {

    setItems(previousItems =>

      previousItems.filter(
        item =>
          item.id !== id
      )

    )


    if (editingId === id) {

      resetEditor()
    }
  }


  // ============================================
  // TOGGLE PURCHASED
  // ============================================

  const handleTogglePurchased = (
    id
  ) => {

    setItems(previousItems =>

      previousItems.map(item =>

        item.id === id
          ? {
              ...item,
              purchased:
                !item.purchased
            }
          : item

      )

    )
  }


  // ============================================
  // CLEAR ALL
  // ============================================

  const handleClearAll = () => {

    const shouldClear =
      window.confirm(
        'Clear all grocery items?'
      )


    if (!shouldClear) {

      return
    }


    setItems([])

    setFilter('ALL')

    resetEditor()
  }


  // ============================================
  // RESET EDITOR
  // ============================================

  function resetEditor() {

    setFormData(
      INITIAL_FORM
    )

    setEditingId(null)

    setFormError('')
  }


  // ============================================
  // DERIVED VALUES
  // ============================================

  const filteredItems =
    items.filter(item => {

      if (
        filter ===
        'PURCHASED'
      ) {

        return item.purchased
      }


      if (
        filter ===
        'UNPURCHASED'
      ) {

        return !item.purchased
      }


      return true
    })


  const totalItems =
    items.length


  const purchasedCount =
    items.filter(
      item =>
        item.purchased
    ).length


  const remainingCount =
    totalItems -
    purchasedCount


  const totalCost =
    items.reduce(
      (sum, item) =>

        sum +
        item.price *
        item.quantity,

      0
    )


  const purchasedCost =
    items
      .filter(
        item =>
          item.purchased
      )
      .reduce(
        (sum, item) =>

          sum +
          item.price *
          item.quantity,

        0
      )


  const progress =
    totalItems === 0
      ? 0
      : Math.round(
          (
            purchasedCount /
            totalItems
          ) * 100
        )


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="grocery-list-container">


      {/* Header */}

      <header className="app-header">

        <h1>
          Grocery List App
        </h1>

        <p>
          Organize your shopping list
        </p>

      </header>


      <div className="app-content">


        {/* ======================================
            FORM
            ====================================== */}

        <section className="form-section">

          <h2>

            {editingId !== null
              ? 'Edit Item'
              : 'Add Item'}

          </h2>


          <form
            onSubmit={handleSubmit}
            className="grocery-form"
            noValidate
          >

            <div className="form-row">


              {/* Item Name */}

              <div className="form-group">

                <label htmlFor="name">
                  Item Name:
                </label>

                <input
                  id="name"
                  type="text"
                  name="name"
                  value={
                    formData.name
                  }
                  onChange={
                    handleFormChange
                  }
                  placeholder="e.g. Milk"
                  className="form-input"
                />

              </div>


              {/* Quantity */}

              <div className="form-group">

                <label htmlFor="quantity">
                  Quantity:
                </label>

                <input
                  id="quantity"
                  type="number"
                  name="quantity"
                  value={
                    formData.quantity
                  }
                  onChange={
                    handleFormChange
                  }
                  min="1"
                  step="1"
                  className="form-input"
                />

              </div>


              {/* Category */}

              <div className="form-group">

                <label htmlFor="category">
                  Category:
                </label>

                <select
                  id="category"
                  name="category"
                  value={
                    formData.category
                  }
                  onChange={
                    handleFormChange
                  }
                  className="form-select"
                >

                  {CATEGORIES.map(
                    category => (

                      <option
                        key={category}
                        value={category}
                      >
                        {category}
                      </option>

                    )
                  )}

                </select>

              </div>


              {/* Price */}

              <div className="form-group">

                <label htmlFor="price">
                  Unit Price:
                </label>

                <input
                  id="price"
                  type="number"
                  name="price"
                  value={
                    formData.price
                  }
                  onChange={
                    handleFormChange
                  }
                  min="0"
                  step="0.01"
                  className="form-input"
                />

              </div>

            </div>


            {formError && (

              <p
                className="error-message"
                role="alert"
              >
                {formError}
              </p>

            )}


            <div className="form-actions">

              <button
                type="submit"
                className="btn-add"
              >

                {editingId !== null
                  ? 'Update Item'
                  : 'Add Item'}

              </button>


              {editingId !== null && (

                <button
                  type="button"
                  onClick={
                    handleCancelEdit
                  }
                  className="btn-cancel"
                >
                  Cancel Edit
                </button>

              )}

            </div>

          </form>

        </section>


        {/* ======================================
            STATISTICS
            ====================================== */}

        <section className="statistics-section">

          <h2>
            Shopping Summary
          </h2>


          <div className="stats-grid">


            <div className="stat-card">

              <h3>
                Total Items
              </h3>

              <p className="stat-value">
                {totalItems}
              </p>

            </div>


            <div className="stat-card">

              <h3>
                Purchased
              </h3>

              <p className="stat-value purchased">
                {purchasedCount}
              </p>

            </div>


            <div className="stat-card">

              <h3>
                Remaining
              </h3>

              <p className="stat-value remaining">
                {remainingCount}
              </p>

            </div>


            <div className="stat-card">

              <h3>
                Total Cost
              </h3>

              <p className="stat-value">

                ${totalCost.toFixed(2)}

              </p>

            </div>

          </div>


          <div className="cost-summary">

            Purchased Cost:
            {' '}

            <strong>

              ${purchasedCost.toFixed(2)}

            </strong>

          </div>


          {/* Progress */}

          <div className="progress-section">

            <p>
              Shopping Progress
            </p>


            <div
              className="progress-bar"
              role="progressbar"
              aria-label="Shopping progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={
                progress
              }
            >

              <div
                className="progress-fill"
                style={{
                  width:
                    `${progress}%`
                }}
              >
              </div>

            </div>


            <p className="progress-text">

              {progress}% Complete

            </p>

          </div>

        </section>


        {/* ======================================
            FILTER
            ====================================== */}

        <section className="filter-section">

          <h2>
            Filter Items
          </h2>


          <div className="filter-buttons">


            <button
              type="button"
              onClick={() =>
                setFilter('ALL')
              }
              className={
                `filter-btn ${
                  filter === 'ALL'
                    ? 'active'
                    : ''
                }`
              }
              aria-pressed={
                filter === 'ALL'
              }
            >

              All ({totalItems})

            </button>


            <button
              type="button"
              onClick={() =>
                setFilter(
                  'UNPURCHASED'
                )
              }
              className={
                `filter-btn ${
                  filter ===
                  'UNPURCHASED'
                    ? 'active'
                    : ''
                }`
              }
              aria-pressed={
                filter ===
                'UNPURCHASED'
              }
            >

              To Buy ({remainingCount})

            </button>


            <button
              type="button"
              onClick={() =>
                setFilter(
                  'PURCHASED'
                )
              }
              className={
                `filter-btn ${
                  filter ===
                  'PURCHASED'
                    ? 'active'
                    : ''
                }`
              }
              aria-pressed={
                filter ===
                'PURCHASED'
              }
            >

              Purchased ({purchasedCount})

            </button>

          </div>

        </section>


        {/* ======================================
            ITEMS
            ====================================== */}

        <section className="items-section">

          <h2>

            Items
            {' '}
            ({filteredItems.length})

          </h2>


          {filteredItems.length === 0 ? (

            <p className="empty-message">

              {items.length === 0
                ? 'No grocery items yet. Add one to get started.'
                : 'No items match the current filter.'}

            </p>

          ) : (

            <div className="items-list">

              {filteredItems.map(item => (

                <article
                  key={item.id}
                  className={
                    `item-card ${
                      item.purchased
                        ? 'purchased'
                        : ''
                    }`
                  }
                >


                  {/* Purchased Checkbox */}

                  <input
                    type="checkbox"
                    checked={
                      item.purchased
                    }
                    onChange={() =>
                      handleTogglePurchased(
                        item.id
                      )
                    }
                    className="item-checkbox"
                    aria-label={
                      `Mark ${item.name} as ${
                        item.purchased
                          ? 'not purchased'
                          : 'purchased'
                      }`
                    }
                  />


                  {/* Details */}

                  <div className="item-details">

                    <h3 className="item-name">

                      {item.name}

                    </h3>


                    <div className="item-meta">

                      <span className="item-category">

                        {item.category}

                      </span>


                      <span className="item-quantity">

                        Qty:
                        {' '}
                        {item.quantity}

                      </span>


                      <span className="item-price">

                        $
                        {
                          (
                            item.price *
                            item.quantity
                          ).toFixed(2)
                        }

                      </span>

                    </div>

                  </div>


                  {/* Actions */}

                  <div className="item-actions">

                    <button
                      type="button"
                      onClick={() =>
                        handleEditItem(
                          item
                        )
                      }
                      className="btn-edit"
                      aria-label={
                        `Edit ${item.name}`
                      }
                    >
                      Edit
                    </button>


                    <button
                      type="button"
                      onClick={() =>
                        handleDeleteItem(
                          item.id
                        )
                      }
                      className="btn-delete"
                      aria-label={
                        `Delete ${item.name}`
                      }
                    >
                      Delete
                    </button>

                  </div>

                </article>

              ))}

            </div>

          )}

        </section>


        {/* ======================================
            CLEAR ALL
            ====================================== */}

        {items.length > 0 && (

          <div className="footer-actions">

            <button
              type="button"
              onClick={
                handleClearAll
              }
              className="btn-clear-all"
            >
              Clear All Items
            </button>

          </div>

        )}

      </div>


      {/* Debug */}

      <details className="debug-section">

        <summary>
          Debug Information
        </summary>

        <pre>

          {JSON.stringify(
            {
              items,
              formData,
              filter,
              editingId
            },
            null,
            2
          )}

        </pre>

      </details>

    </div>
  )
}


================================================================================
STATE RESPONSIBILITIES
================================================================================

items:
--------------------------------------------------------------------------------

Source of truth for grocery records


formData:
--------------------------------------------------------------------------------

Temporary controlled-form values


filter:
--------------------------------------------------------------------------------

Determines which items are visible


editingId:
--------------------------------------------------------------------------------

Identifies the item currently being edited


formError:
--------------------------------------------------------------------------------

Simple form validation feedback


================================================================================
IMPORTANT: DO NOT STORE DERIVED VALUES IN STATE
================================================================================

These values can be calculated from items:

filteredItems

totalItems

purchasedCount

remainingCount

totalCost

purchasedCost

progress


Therefore they usually do NOT need:

useState()


Example:

const totalItems =
  items.length


instead of:

const [totalItems, setTotalItems] =
  useState(0)


MEMORY:
--------------------------------------------------------------------------------

IF A VALUE CAN BE CALCULATED DIRECTLY
FROM EXISTING STATE,

DERIVE IT INSTEAD OF DUPLICATING IT.



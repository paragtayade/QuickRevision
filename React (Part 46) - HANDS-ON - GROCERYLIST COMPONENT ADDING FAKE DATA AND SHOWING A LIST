PART 4: BUILDING THE GroceryList COMPONENT
================================================================================

File:

src/components/GroceryList.jsx


import { useState } from 'react'

import {
  FAKE_GROCERIES
} from '../data/fakeGroceries'

import './GroceryList.css'


export default function GroceryList() {

  // ============================================
  // STATE
  // ============================================

  const [
    groceryItems,
    setGroceryItems
  ] = useState(
    FAKE_GROCERIES
  )


  const [filter, setFilter] =
    useState('ALL')


  // ============================================
  // DERIVED ITEMS
  // ============================================

  const filteredItems =
    groceryItems.filter(
      item => {

        if (
          filter ===
          'PURCHASED'
        ) {

          return item.purchased
        }


        if (
          filter ===
          'UNPURCHASED'
        ) {

          return !item.purchased
        }


        return true
      }
    )


  // ============================================
  // DERIVED STATISTICS
  // ============================================

  const totalItems =
    groceryItems.length


  const purchasedCount =
    groceryItems.filter(
      item =>
        item.purchased
    ).length


  const remainingCount =
    totalItems -
    purchasedCount


  const totalCost =
    groceryItems.reduce(

      (sum, item) =>

        sum +
        item.price *
        item.quantity,

      0
    )


  const purchasedCost =
    groceryItems
      .filter(
        item =>
          item.purchased
      )
      .reduce(

        (sum, item) =>

          sum +
          item.price *
          item.quantity,

        0
      )


  const averageLineCost =
    totalItems === 0
      ? 0
      : totalCost /
        totalItems


  // ============================================
  // TOGGLE PURCHASED
  // ============================================

  const handleTogglePurchased = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.map(
          item =>

            item.id === id
              ? {
                  ...item,

                  purchased:
                    !item.purchased
                }
              : item
        )
    )
  }


  // ============================================
  // DELETE ITEM
  // ============================================

  const handleDeleteItem = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.filter(
          item =>
            item.id !== id
        )
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="grocery-list-container">


      {/* Header */}

      <header className="list-header">

        <h1>
          Grocery List
        </h1>

        <p>
          Manage your shopping items
        </p>

      </header>


      {/* Statistics */}

      <section
        className="statistics-section"
        aria-label="Grocery statistics"
      >


        <div className="stat-card">

          <h3>
            Total Items
          </h3>

          <p className="stat-value">

            {totalItems}

          </p>

        </div>


        <div className="stat-card">

          <h3>
            Purchased
          </h3>

          <p className="stat-value purchased">

            {purchasedCount}

          </p>

        </div>


        <div className="stat-card">

          <h3>
            Remaining
          </h3>

          <p className="stat-value remaining">

            {remainingCount}

          </p>

        </div>


        <div className="stat-card">

          <h3>
            Total Cost
          </h3>

          <p className="stat-value">

            ${totalCost.toFixed(2)}

          </p>

        </div>

      </section>


      {/* Filter */}

      <section className="filter-section">

        <h2>
          Filter Items
        </h2>


        <div className="filter-buttons">


          <button
            type="button"
            onClick={() =>
              setFilter('ALL')
            }
            className={
              `filter-btn ${
                filter === 'ALL'
                  ? 'active'
                  : ''
              }`
            }
            aria-pressed={
              filter === 'ALL'
            }
          >

            All ({totalItems})

          </button>


          <button
            type="button"
            onClick={() =>
              setFilter(
                'UNPURCHASED'
              )
            }
            className={
              `filter-btn ${
                filter ===
                'UNPURCHASED'
                  ? 'active'
                  : ''
              }`
            }
            aria-pressed={
              filter ===
              'UNPURCHASED'
            }
          >

            To Buy ({remainingCount})

          </button>


          <button
            type="button"
            onClick={() =>
              setFilter(
                'PURCHASED'
              )
            }
            className={
              `filter-btn ${
                filter ===
                'PURCHASED'
                  ? 'active'
                  : ''
              }`
            }
            aria-pressed={
              filter ===
              'PURCHASED'
            }
          >

            Purchased ({purchasedCount})

          </button>

        </div>

      </section>


      {/* Items */}

      <section className="items-section">

        <h2>

          Items
          {' '}
          ({filteredItems.length})

        </h2>


        {filteredItems.length === 0 ? (

          <div className="empty-state">

            <p className="empty-message">

              {groceryItems.length === 0
                ? 'No items in your grocery list.'
                : 'No items match this filter.'}

            </p>

          </div>

        ) : (

          <div className="items-list">

            {filteredItems.map(
              item => (

                <article
                  key={item.id}
                  className={
                    `item-card ${
                      item.purchased
                        ? 'purchased'
                        : ''
                    }`
                  }
                >


                  {/* Purchased */}

                  <input
                    type="checkbox"
                    checked={
                      item.purchased
                    }
                    onChange={() =>
                      handleTogglePurchased(
                        item.id
                      )
                    }
                    className="item-checkbox"
                    aria-label={
                      `Mark ${item.name} as ${
                        item.purchased
                          ? 'not purchased'
                          : 'purchased'
                      }`
                    }
                  />


                  {/* Item Details */}

                  <div className="item-details">

                    <h3 className="item-name">

                      {item.name}

                    </h3>


                    <div className="item-meta">

                      <span className="item-category">

                        {item.category}

                      </span>


                      <span className="item-quantity">

                        Qty:
                        {' '}
                        {item.quantity}

                      </span>


                      <span className="item-price">

                        $
                        {
                          (
                            item.price *
                            item.quantity
                          ).toFixed(2)
                        }

                      </span>

                    </div>


                    <p className="item-unit-price">

                      ${item.price.toFixed(2)}
                      {' '}
                      each

                    </p>

                  </div>


                  {/* Delete */}

                  <button
                    type="button"
                    onClick={() =>
                      handleDeleteItem(
                        item.id
                      )
                    }
                    className="btn-delete"
                    aria-label={
                      `Delete ${item.name}`
                    }
                  >

                    Delete

                  </button>

                </article>

              )
            )}

          </div>

        )}

      </section>


      {/* Educational Debug Information */}

      <details className="debug-section">

        <summary>
          Debug Information
        </summary>

        <pre>

          {JSON.stringify(
            groceryItems,
            null,
            2
          )}

        </pre>

      </details>


      {/* Additional Derived Statistics */}

      <section className="info-box">

        <h3>
          Additional Calculations
        </h3>

        <p>

          Purchased Cost:
          {' '}

          <strong>
            ${purchasedCost.toFixed(2)}
          </strong>

        </p>

        <p>

          Average Line Cost:
          {' '}

          <strong>
            ${averageLineCost.toFixed(2)}
          </strong>

        </p>

      </section>

    </div>
  )
}



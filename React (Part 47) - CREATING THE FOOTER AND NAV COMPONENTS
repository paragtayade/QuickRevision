import {
  render,
  screen
} from '@testing-library/react'

import userEvent
  from '@testing-library/user-event'

import Navigation
  from './Navigation'


test(
  'toggles the mobile navigation state',

  async () => {

    const user =
      userEvent.setup()


    render(
      <Navigation />
    )


    const button =
      screen.getByRole(
        'button',
        {
          name:
            /open navigation menu/i
        }
      )


    expect(
      button
    ).toHaveAttribute(
      'aria-expanded',
      'false'
    )


    await user.click(
      button
    )


    expect(
      button
    ).toHaveAttribute(
      'aria-expanded',
      'true'
    )
  }
)



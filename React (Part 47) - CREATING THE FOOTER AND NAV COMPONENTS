import Navigation
  from './components/Navigation'

import GroceryList
  from './components/GroceryList'

import Footer
  from './components/Footer'

import './App.css'


export default function App() {

  return (
    <div className="app">

      <Navigation />


      <main
        id="home"
        className="app-main"
      >

        <div className="app-container">

          <section
            id="grocery-list"
            aria-labelledby="grocery-title"
          >

            <h1 id="grocery-title">

              Grocery List App

            </h1>


            <GroceryList />

          </section>

        </div>

      </main>


      <Footer />

    </div>
  )
}


================================================================================
WHY REMOVE DUPLICATE GROCERY STATE FROM App?
================================================================================

The original example created:

const [
  groceryItems,
  setGroceryItems
] = useState(...)


inside App.


But then:

<GroceryList
  items={groceryItems}
/>


conflicts with the Lesson 10 version where GroceryList creates and manages its
own:

groceryItems


Choose ONE state owner.


OPTION A:
--------------------------------------------------------------------------------

GroceryList owns grocery state


App
 ↓
<GroceryList />


OPTION B:
--------------------------------------------------------------------------------

Lift grocery state to App


App
├── groceryItems
├── setGroceryItems
│
└── GroceryList receives:
    items
    callbacks


Do not accidentally maintain two independent grocery arrays.



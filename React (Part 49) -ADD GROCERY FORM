import { useState } from 'react'

import GroceryItem
  from './GroceryItem'


export default function GroceryList({

  items,

  onTogglePurchased,

  onDeleteItem,

  onEditItem

}) {

  const [filter, setFilter] =
    useState('ALL')


  const filteredItems =
    items.filter(item => {

      if (
        filter ===
        'PURCHASED'
      ) {

        return item.purchased
      }


      if (
        filter ===
        'UNPURCHASED'
      ) {

        return !item.purchased
      }


      return true
    })


  return (
    <div className="items-list">

      {filteredItems.map(
        item => (

          <GroceryItem
            key={item.id}
            item={item}
            onTogglePurchased={
              onTogglePurchased
            }
            onEditItem={
              onEditItem
            }
            onDeleteItem={
              onDeleteItem
            }
          />

        )
      )}

    </div>
  )
}



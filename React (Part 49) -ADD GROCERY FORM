import { useState } from 'react'

import './AddGroceryForm.css'


const CATEGORIES = [

  'Produce',

  'Dairy',

  'Bakery',

  'Meat',

  'Frozen',

  'Pantry',

  'Beverages',

  'Snacks'

]


const INITIAL_FORM = {

  name: '',

  quantity: '1',

  category: 'Produce',

  price: ''

}


export default function AddGroceryForm({

  onAddItem

}) {

  // ============================================
  // STATE
  // ============================================

  const [formData, setFormData] =
    useState(INITIAL_FORM)


  const [errors, setErrors] =
    useState({})


  const [
    successMessage,
    setSuccessMessage
  ] = useState('')


  // ============================================
  // DERIVED PREVIEW
  // ============================================

  const numericQuantity =
    Number(formData.quantity)


  const numericPrice =
    Number(formData.price)


  const lineCost =
    Number.isFinite(
      numericQuantity
    ) &&
    Number.isFinite(
      numericPrice
    )
      ? numericQuantity *
        numericPrice
      : 0


  // ============================================
  // VALIDATION
  // ============================================

  const validateForm = () => {

    const newErrors = {}


    const itemName =
      formData.name.trim()


    const quantity =
      Number(formData.quantity)


    const price =
      Number(formData.price)


    // Item Name

    if (!itemName) {

      newErrors.name =
        'Item name is required'

    } else if (
      itemName.length < 2
    ) {

      newErrors.name =
        'Item name must contain at least 2 characters'

    } else if (
      itemName.length > 50
    ) {

      newErrors.name =
        'Item name must not exceed 50 characters'
    }


    // Quantity

    if (
      formData.quantity === ''
    ) {

      newErrors.quantity =
        'Quantity is required'

    } else if (
      !Number.isInteger(
        quantity
      )
    ) {

      newErrors.quantity =
        'Quantity must be a whole number'

    } else if (
      quantity < 1
    ) {

      newErrors.quantity =
        'Quantity must be at least 1'

    } else if (
      quantity > 999
    ) {

      newErrors.quantity =
        'Quantity must not exceed 999'
    }


    // Category

    if (
      !CATEGORIES.includes(
        formData.category
      )
    ) {

      newErrors.category =
        'Select a valid category'
    }


    // Price

    if (
      formData.price === ''
    ) {

      newErrors.price =
        'Price is required'

    } else if (
      !Number.isFinite(price)
    ) {

      newErrors.price =
        'Price must be a number'

    } else if (
      price < 0
    ) {

      newErrors.price =
        'Price cannot be negative'

    } else if (
      price > 9999
    ) {

      newErrors.price =
        'Price must not exceed 9999'
    }


    return newErrors
  }


  // ============================================
  // CHANGE HANDLER
  // ============================================

  const handleChange = (
    event
  ) => {

    const {
      name,
      value
    } = event.target


    setFormData(
      previousData => ({

        ...previousData,

        [name]:
          value

      })
    )


    // Clear the old error for this field.

    setErrors(
      previousErrors => {

        if (
          !previousErrors[name]
        ) {

          return previousErrors
        }


        return {

          ...previousErrors,

          [name]:
            ''

        }
      }
    )


    setSuccessMessage('')
  }


  // ============================================
  // SUBMIT HANDLER
  // ============================================

  const handleSubmit = (
    event
  ) => {

    event.preventDefault()


    const validationErrors =
      validateForm()


    if (
      Object.keys(
        validationErrors
      ).length > 0
    ) {

      setErrors(
        validationErrors
      )

      setSuccessMessage('')

      return
    }


    const newItem = {

      id:
        crypto.randomUUID(),

      name:
        formData.name.trim(),

      quantity:
        Number(
          formData.quantity
        ),

      category:
        formData.category,

      price:
        Number(
          formData.price
        ),

      purchased:
        false,

      createdAt:
        new Date()
          .toISOString()

    }


    onAddItem(newItem)


    setFormData(
      INITIAL_FORM
    )


    setErrors({})


    setSuccessMessage(
      `${newItem.name} was added successfully.`
    )
  }


  // ============================================
  // RESET HANDLER
  // ============================================

  const handleReset = () => {

    setFormData(
      INITIAL_FORM
    )

    setErrors({})

    setSuccessMessage('')
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <section
      className="add-grocery-form-container"
      aria-labelledby="add-grocery-title"
    >


      {/* Header */}

      <header className="form-header">

        <h2 id="add-grocery-title">

          Add New Item

        </h2>

        <p className="form-subtitle">

          Add an item to your grocery list

        </p>

      </header>


      {/* Success */}

      {successMessage && (

        <p
          className="success-message"
          role="status"
        >

          {successMessage}

        </p>

      )}


      {/* Form */}

      <form
        onSubmit={handleSubmit}
        onReset={handleReset}
        className="grocery-form"
        noValidate
      >


        {/* ======================================
            ITEM NAME
            ====================================== */}

        <div className="form-group">

          <label
            htmlFor="name"
            className="form-label"
          >

            Item Name

            <span
              className="required"
              aria-hidden="true"
            >
              *
            </span>

          </label>


          <input
            id="name"
            type="text"
            name="name"
            value={
              formData.name
            }
            onChange={
              handleChange
            }
            placeholder="e.g. Milk"
            className={
              `form-input ${
                errors.name
                  ? 'input-error'
                  : ''
              }`
            }
            aria-invalid={
              Boolean(
                errors.name
              )
            }
            aria-describedby={
              [
                'name-hint',
                errors.name
                  ? 'name-error'
                  : null
              ]
                .filter(Boolean)
                .join(' ')
            }
          />


          {errors.name && (

            <p
              id="name-error"
              className="error-message"
            >
              {errors.name}
            </p>

          )}


          <p
            id="name-hint"
            className="form-hint"
          >

            Enter the item you want to buy.

          </p>

        </div>


        {/* ======================================
            QUANTITY + CATEGORY
            ====================================== */}

        <div className="form-row">


          {/* Quantity */}

          <div className="form-group">

            <label
              htmlFor="quantity"
              className="form-label"
            >

              Quantity

              <span
                className="required"
                aria-hidden="true"
              >
                *
              </span>

            </label>


            <input
              id="quantity"
              type="number"
              name="quantity"
              value={
                formData.quantity
              }
              onChange={
                handleChange
              }
              min="1"
              max="999"
              step="1"
              className={
                `form-input ${
                  errors.quantity
                    ? 'input-error'
                    : ''
                }`
              }
              aria-invalid={
                Boolean(
                  errors.quantity
                )
              }
              aria-describedby={
                [
                  'quantity-hint',
                  errors.quantity
                    ? 'quantity-error'
                    : null
                ]
                  .filter(Boolean)
                  .join(' ')
              }
            />


            {errors.quantity && (

              <p
                id="quantity-error"
                className="error-message"
              >
                {errors.quantity}
              </p>

            )}


            <p
              id="quantity-hint"
              className="form-hint"
            >

              Enter a whole number from 1 to 999.

            </p>

          </div>


          {/* Category */}

          <div className="form-group">

            <label
              htmlFor="category"
              className="form-label"
            >

              Category

              <span
                className="required"
                aria-hidden="true"
              >
                *
              </span>

            </label>


            <select
              id="category"
              name="category"
              value={
                formData.category
              }
              onChange={
                handleChange
              }
              className={
                `form-select ${
                  errors.category
                    ? 'input-error'
                    : ''
                }`
              }
              aria-invalid={
                Boolean(
                  errors.category
                )
              }
              aria-describedby={
                errors.category
                  ? 'category-error'
                  : undefined
              }
            >

              {CATEGORIES.map(
                category => (

                  <option
                    key={category}
                    value={category}
                  >
                    {category}
                  </option>

                )
              )}

            </select>


            {errors.category && (

              <p
                id="category-error"
                className="error-message"
              >
                {errors.category}
              </p>

            )}

          </div>

        </div>


        {/* ======================================
            PRICE
            ====================================== */}

        <div className="form-group">

          <label
            htmlFor="price"
            className="form-label"
          >

            Unit Price

            <span
              className="required"
              aria-hidden="true"
            >
              *
            </span>

          </label>


          <div className="price-input-wrapper">

            <span
              className="price-currency"
              aria-hidden="true"
            >
              $
            </span>


            <input
              id="price"
              type="number"
              name="price"
              value={
                formData.price
              }
              onChange={
                handleChange
              }
              min="0"
              max="9999"
              step="0.01"
              placeholder="0.00"
              className={
                `form-input price-input ${
                  errors.price
                    ? 'input-error'
                    : ''
                }`
              }
              aria-invalid={
                Boolean(
                  errors.price
                )
              }
              aria-describedby={
                [
                  'price-hint',
                  errors.price
                    ? 'price-error'
                    : null
                ]
                  .filter(Boolean)
                  .join(' ')
              }
            />

          </div>


          {errors.price && (

            <p
              id="price-error"
              className="error-message"
            >
              {errors.price}
            </p>

          )}


          <p
            id="price-hint"
            className="form-hint"
          >

            Enter the price for one item.

          </p>

        </div>


        {/* ======================================
            LIVE SUMMARY
            ====================================== */}

        <div className="form-summary">

          <span className="summary-label">

            Estimated Line Cost:

          </span>


          <output className="summary-value">

            ${lineCost.toFixed(2)}

          </output>

        </div>


        {/* ======================================
            BUTTONS
            ====================================== */}

        <div className="form-buttons">

          <button
            type="submit"
            className="btn btn-primary"
          >
            Add Item
          </button>


          <button
            type="reset"
            className="btn btn-secondary"
          >
            Clear Form
          </button>

        </div>

      </form>


      {/* Information */}

      <div className="form-info">

        <p className="info-text">

          Fields marked with * are required.

        </p>

      </div>


      {/* Educational Debug Output */}

      <details className="debug-section">

        <summary>
          Current Form Data
        </summary>

        <pre>
          {JSON.stringify(
            formData,
            null,
            2
          )}
        </pre>

      </details>

    </section>
  )
}


================================================================================
CRITICAL COMPUTED-PROPERTY PATTERN
================================================================================

The reusable handler must update the property identified by `name`.

Correct:

setFormData(
  previousData => ({

    ...previousData,

    [name]:
      value

  })
)


If:

name = 'price'

value = '3.99'


Then:

[name]: value


becomes:

price:
'3.99'


Do NOT accidentally write:

{
  ...previousData,
  value
}


That would create or update a property literally named:

value


instead of updating:

name

quantity

category

or:

price


================================================================================
WHY NOT parseFloat() ON EVERY CHANGE?
================================================================================

The original example used:

parseFloat(value) || 0


This causes a problem.

Suppose a user clears the Price input.

value:

''


parseFloat(''):

NaN


NaN || 0:

0


The input immediately becomes:

0


This makes a temporary empty editing state difficult.


BETTER:
--------------------------------------------------------------------------------

Keep the raw input string during editing:

[name]:
value


Then convert after validation:

price:
Number(formData.price)


================================================================================
FORM SUBMISSION FLOW
================================================================================

User Submits
     ↓
preventDefault()
     ↓
validateForm()
     ↓
Errors?
     │
     ├── YES
     │     ↓
     │   setErrors()
     │     ↓
     │   Stop
     │
     └── NO
           ↓
         Normalize Values
           ↓
         Create newItem
           ↓
         onAddItem(newItem)
           ↓
         Reset Form
           ↓
         Show Status Message



import { useState } from 'react'

import Navigation
  from './components/Navigation'

import AddGroceryForm
  from './components/AddGroceryForm'

import GroceryList
  from './components/GroceryList'

import Footer
  from './components/Footer'

import {
  FAKE_GROCERIES
} from './data/fakeGroceries'

import './App.css'


export default function App() {

  // ============================================
  // SHARED STATE
  // ============================================

  const [
    groceryItems,
    setGroceryItems
  ] = useState(
    FAKE_GROCERIES
  )


  // ============================================
  // ADD
  // ============================================

  const handleAddItem = (
    newItem
  ) => {

    setGroceryItems(
      previousItems => [

        newItem,

        ...previousItems

      ]
    )
  }


  // ============================================
  // TOGGLE
  // ============================================

  const handleTogglePurchased = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.map(
          item =>

            item.id === id
              ? {
                  ...item,

                  purchased:
                    !item.purchased
                }
              : item
        )
    )
  }


  // ============================================
  // DELETE
  // ============================================

  const handleDeleteItem = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.filter(
          item =>
            item.id !== id
        )
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="app">

      <Navigation />


      <main className="app-main">

        <div className="app-container">


          <header className="app-header">

            <h1>
              Grocery List App
            </h1>

            <p>
              Manage your shopping list
            </p>

          </header>


          <section
            className="form-section"
            aria-label="Add grocery item"
          >

            <AddGroceryForm
              onAddItem={
                handleAddItem
              }
            />

          </section>


          <section
            id="grocery-list"
            className="list-section"
            aria-label="Grocery items"
          >

            <GroceryList
              items={
                groceryItems
              }
              onTogglePurchased={
                handleTogglePurchased
              }
              onDeleteItem={
                handleDeleteItem
              }
            />

          </section>

        </div>

      </main>


      <Footer />

    </div>
  )
}



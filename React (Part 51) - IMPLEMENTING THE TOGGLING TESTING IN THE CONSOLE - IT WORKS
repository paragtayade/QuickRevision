File:

src/App.jsx


import { useState } from 'react'

import Navigation
  from './components/Navigation'

import GroceryList
  from './components/GroceryList'

import AddGroceryForm
  from './components/AddGroceryForm'

import Footer
  from './components/Footer'

import {
  FAKE_GROCERIES
} from './data/fakeGroceries'

import './App.css'


export default function App() {

  // ============================================
  // STATE
  // ============================================

  const [
    groceryItems,
    setGroceryItems
  ] = useState(
    FAKE_GROCERIES
  )


  // ============================================
  // TOGGLE BOUGHT
  // ============================================

  const handleToggleBought = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.map(
          item => {

            if (
              item.id !== id
            ) {

              return item
            }


            return {

              ...item,

              purchased:
                !item.purchased

            }
          }
        )
    )
  }


  // ============================================
  // ADD ITEM
  // ============================================

  const handleAddItem = (
    newItem
  ) => {

    setGroceryItems(
      previousItems => [

        newItem,

        ...previousItems

      ]
    )
  }


  // ============================================
  // DELETE ITEM
  // ============================================

  const handleDeleteItem = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.filter(
          item =>
            item.id !== id
        )
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="app">

      <Navigation />


      <main className="app-main">

        <div className="app-container">


          <header className="app-header">

            <h1>
              Grocery List App
            </h1>

            <p>
              Manage your shopping list
            </p>

          </header>


          <section className="form-section">

            <AddGroceryForm
              onAddItem={
                handleAddItem
              }
            />

          </section>


          <section
            id="grocery-list"
            className="list-section"
          >

            <GroceryList
              items={
                groceryItems
              }
              onToggleBought={
                handleToggleBought
              }
              onDeleteItem={
                handleDeleteItem
              }
            />

          </section>

        </div>

      </main>


      <Footer />

    </div>
  )
}



import './GroceryItem.css'


export default function GroceryItem({

  item,

  onToggleBought,

  onDeleteItem

}) {

  // ============================================
  // HANDLERS
  // ============================================

  const handleCheckboxChange = () => {

    onToggleBought(
      item.id
    )
  }


  const handleDelete = () => {

    onDeleteItem(
      item.id
    )
  }


  // ============================================
  // DERIVED DISPLAY VALUE
  // ============================================

  const lineCost =
    item.price *
    item.quantity


  // ============================================
  // RENDER
  // ============================================

  return (
    <article
      className={
        `item-card ${
          item.purchased
            ? 'purchased'
            : ''
        }`
      }
    >


      {/* Purchase Status */}

      <div className="item-checkbox-wrapper">

        <input
          type="checkbox"
          checked={
            item.purchased
          }
          onChange={
            handleCheckboxChange
          }
          className="item-checkbox"
          aria-label={
            `Mark ${item.name} as ${
              item.purchased
                ? 'not purchased'
                : 'purchased'
            }`
          }
        />

      </div>


      {/* Item Details */}

      <div className="item-details">


        <h3 className="item-name">

          {item.name}

        </h3>


        <div className="item-meta">


          <span className="item-category">

            <i
              className="bi bi-tag"
              aria-hidden="true"
            ></i>

            {item.category}

          </span>


          <span className="item-quantity">

            <i
              className="bi bi-box"
              aria-hidden="true"
            ></i>

            Qty:
            {' '}
            {item.quantity}

          </span>


          <span className="item-total-price">

            ${lineCost.toFixed(2)}

          </span>

        </div>


        <p className="item-unit-price">

          ${item.price.toFixed(2)}
          {' '}
          each

        </p>

      </div>


      {/* Actions */}

      <div className="item-actions">

        <button
          type="button"
          onClick={
            handleDelete
          }
          className="btn-action btn-delete"
          title="Delete item"
          aria-label={
            `Delete ${item.name}`
          }
        >

          <i
            className="bi bi-trash"
            aria-hidden="true"
          ></i>

        </button>

      </div>

    </article>
  )
}



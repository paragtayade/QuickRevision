PART 3: CREATING THE handleRemoveItem HANDLER
================================================================================

The grocery state already lives in:

App


Therefore the delete handler should also live in:

App


Why?

The component that owns the state should perform the state update.


================================================================================
App.jsx
================================================================================

import { useState } from 'react'

import Navigation
  from './components/Navigation'

import AddGroceryForm
  from './components/AddGroceryForm'

import GroceryList
  from './components/GroceryList'

import Footer
  from './components/Footer'

import {
  FAKE_GROCERIES
} from './data/fakeGroceries'

import './App.css'


export default function App() {

  // ============================================
  // STATE
  // ============================================

  const [
    groceryItems,
    setGroceryItems
  ] = useState(
    FAKE_GROCERIES
  )


  // ============================================
  // ADD
  // ============================================

  const handleAddItem = (
    newItem
  ) => {

    setGroceryItems(
      previousItems => [

        newItem,

        ...previousItems

      ]
    )
  }


  // ============================================
  // TOGGLE BOUGHT
  // ============================================

  const handleToggleBought = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.map(
          item =>

            item.id === id
              ? {
                  ...item,

                  purchased:
                    !item.purchased
                }
              : item

        )
    )
  }


  // ============================================
  // REMOVE ITEM
  // ============================================

  const handleRemoveItem = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.filter(
          item =>
            item.id !== id
        )
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="app">

      <Navigation />


      <main className="app-main">

        <div className="app-container">


          <header className="app-header">

            <h1>
              Grocery List App
            </h1>

            <p>
              Manage your shopping list
            </p>

          </header>


          <section className="form-section">

            <AddGroceryForm
              onAddItem={
                handleAddItem
              }
            />

          </section>


          <section
            id="grocery-list"
            className="list-section"
          >

            <GroceryList
              items={
                groceryItems
              }
              onToggleBought={
                handleToggleBought
              }
              onRemoveItem={
                handleRemoveItem
              }
            />

          </section>

        </div>

      </main>


      <Footer />

    </div>
  )
}



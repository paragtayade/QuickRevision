import { useState } from 'react'

import GroceryItem
  from './GroceryItem'

import './GroceryList.css'


export default function GroceryList({

  items,

  onToggleBought,

  onRemoveItem

}) {

  const [filter, setFilter] =
    useState('ALL')


  const filteredItems =
    items.filter(item => {

      if (
        filter ===
        'PURCHASED'
      ) {

        return item.purchased
      }


      if (
        filter ===
        'UNPURCHASED'
      ) {

        return !item.purchased
      }


      return true
    })


  return (
    <section className="grocery-list-container">

      <h2>

        Grocery Items
        {' '}
        ({filteredItems.length})

      </h2>


      {/* Filter Controls */}

      <div className="filter-buttons">


        <button
          type="button"
          onClick={() =>
            setFilter('ALL')
          }
        >
          All
        </button>


        <button
          type="button"
          onClick={() =>
            setFilter(
              'UNPURCHASED'
            )
          }
        >
          To Buy
        </button>


        <button
          type="button"
          onClick={() =>
            setFilter(
              'PURCHASED'
            )
          }
        >
          Purchased
        </button>

      </div>


      {filteredItems.length === 0 ? (

        <p className="empty-message">

          {items.length === 0
            ? 'No items in your grocery list.'
            : 'No items match the current filter.'}

        </p>

      ) : (

        <div className="items-grid">

          {filteredItems.map(
            item => (

              <GroceryItem
                key={item.id}
                item={item}
                onToggleBought={
                  onToggleBought
                }
                onRemoveItem={
                  onRemoveItem
                }
              />

            )
          )}

        </div>

      )}

    </section>
  )
}



================================================================================

import { useState } from 'react'

import Navigation
  from './components/Navigation'

import GroceryList
  from './components/GroceryList'

import AddGroceryForm
  from './components/AddGroceryForm'

import Footer
  from './components/Footer'

import {
  FAKE_GROCERIES
} from './data/fakeGroceries'

import {
  calculateStats
} from './utils/statsCalculator'

import './App.css'


export default function App() {

  // ============================================
  // STATE
  // ============================================

  const [
    groceryItems,
    setGroceryItems
  ] = useState(
    FAKE_GROCERIES
  )


  // ============================================
  // DERIVED STATISTICS
  // ============================================

  const stats =
    calculateStats(
      groceryItems
    )


  // ============================================
  // ADD
  // ============================================

  const handleAddItem = (
    newItem
  ) => {

    setGroceryItems(
      previousItems => [

        newItem,

        ...previousItems

      ]
    )
  }


  // ============================================
  // TOGGLE
  // ============================================

  const handleToggleBought = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.map(
          item =>

            item.id === id
              ? {
                  ...item,

                  purchased:
                    !item.purchased
                }
              : item
        )
    )
  }


  // ============================================
  // REMOVE
  // ============================================

  const handleRemoveItem = (
    id
  ) => {

    setGroceryItems(
      previousItems =>

        previousItems.filter(
          item =>
            item.id !== id
        )
    )
  }


  // ============================================
  // RENDER
  // ============================================

  return (
    <div className="app">

      <Navigation />


      <main className="app-main">

        <div className="app-container">


          <header className="app-header">

            <h1>
              Grocery List App
            </h1>

            <p>
              Manage your shopping list
            </p>

          </header>


          <section className="form-section">

            <AddGroceryForm
              onAddItem={
                handleAddItem
              }
            />

          </section>


          <section
            id="grocery-list"
            className="list-section"
          >

            <GroceryList
              items={
                groceryItems
              }
              onToggleBought={
                handleToggleBought
              }
              onRemoveItem={
                handleRemoveItem
              }
            />

          </section>

        </div>

      </main>


      <Footer
        stats={
          stats
        }
      />

    </div>
  )
}


================================================================================
IMPORTANT: STATS ARE NOT STATE
================================================================================

Avoid:

const [
  stats,
  setStats
] = useState(...)


followed by manually updating stats whenever groceries change.


Why?

stats can already be calculated from:

groceryItems


Therefore:

const stats =
  calculateStats(
    groceryItems
  )


is enough.


MEMORY:

IF DATA CAN BE CALCULATED FROM EXISTING STATE,
DERIVE IT INSTEAD OF DUPLICATING IT.


================================================================================
PROP FLOW
================================================================================

App:

groceryItems
      ↓
calculateStats()
      ↓
stats


Then:

<Footer
  stats={stats}
/>


Footer receives:

function Footer({

  stats

})



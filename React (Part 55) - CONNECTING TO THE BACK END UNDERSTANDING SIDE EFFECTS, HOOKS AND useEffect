================================================================================
DEPENDENCY MEMORY
================================================================================

NO ARRAY:

Effect after every relevant render


EMPTY ARRAY:

No changing reactive dependencies


ONE DEPENDENCY:

[userId]


Effect responds to:

userId


MULTIPLE:

[userId, filter]


Effect responds to:

userId

or:

filter


================================================================================
API FETCH PATTERN
================================================================================

useEffect(() => {

  const controller =
    new AbortController()


  const fetchData =
    async () => {

      try {

        setLoading(true)

        setError(null)


        const response =
          await fetch(
            `/api/data/${id}`,
            {
              signal:
                controller.signal
            }
          )


        if (!response.ok) {

          throw new Error(
            `Request failed: ${response.status}`
          )
        }


        const result =
          await response.json()


        setData(
          result
        )


      } catch (error) {

        if (
          error.name ===
          'AbortError'
        ) {

          return
        }


        setError(
          error instanceof Error
            ? error.message
            : 'Request failed'
        )


      } finally {

        if (
          !controller.signal.aborted
        ) {

          setLoading(false)
        }

      }
    }


  fetchData()


  return () => {

    controller.abort()

  }

}, [
  id
])



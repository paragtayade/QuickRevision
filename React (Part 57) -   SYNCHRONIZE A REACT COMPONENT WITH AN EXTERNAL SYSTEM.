PART 9: CONNECTING THIS TO GROCERYLIST
================================================================================

So far the Grocery List used:

FAKE_GROCERIES


Eventually we want:

Backend API
    ↓
GET /api/groceries
    ↓
React State
    ↓
GroceryList


================================================================================
CONCEPTUAL App.jsx
================================================================================

import {

  useEffect,

  useState

} from 'react'


export default function App() {

  const [
    groceryItems,
    setGroceryItems
  ] = useState([])


  const [
    loading,
    setLoading
  ] = useState(true)


  const [
    error,
    setError
  ] = useState(null)


  useEffect(() => {

    const controller =
      new AbortController()


    const loadGroceries =
      async () => {

        try {

          setLoading(true)

          setError(null)


          const response =
            await fetch(
              '/api/groceries',
              {
                signal:
                  controller.signal
              }
            )


          if (!response.ok) {

            throw new Error(
              `Unable to load groceries: ${response.status}`
            )
          }


          const groceries =
            await response.json()


          setGroceryItems(
            groceries
          )


        } catch (error) {

          if (
            error.name ===
            'AbortError'
          ) {

            return
          }


          setError(
            error instanceof Error
              ? error.message
              : 'Unable to load groceries'
          )


        } finally {

          if (
            !controller.signal.aborted
          ) {

            setLoading(
              false
            )
          }

        }
      }


    loadGroceries()


    return () => {

      controller.abort()

    }

  }, [])


  if (loading) {

    return (
      <p role="status">

        Loading groceries...

      </p>
    )
  }


  if (error) {

    return (
      <p role="alert">

        {error}

      </p>
    )
  }


  return (

    <GroceryList
      items={
        groceryItems
      }
    />

  )
}



PART 4: COMPLETE DATA-FETCHING EXAMPLE
================================================================================

File:

src/components/MyComponent.jsx


import {

  useEffect,

  useState

} from 'react'


export default function MyComponent() {

  // ============================================
  // STATE
  // ============================================

  const [
    data,
    setData
  ] = useState(null)


  const [
    loading,
    setLoading
  ] = useState(true)


  const [
    error,
    setError
  ] = useState(null)


  // ============================================
  // EFFECT
  // ============================================

  useEffect(() => {

    const controller =
      new AbortController()


    const getData =
      async () => {

        try {

          setLoading(true)

          setError(null)


          const response =
            await fetch(
              '/api/data',
              {
                signal:
                  controller.signal
              }
            )


          if (!response.ok) {

            throw new Error(
              `Request failed with status ${response.status}`
            )
          }


          const result =
            await response.json()


          setData(
            result
          )


        } catch (error) {

          if (
            error.name ===
            'AbortError'
          ) {

            return
          }


          setError(
            error instanceof Error
              ? error.message
              : 'Unable to load data'
          )


        } finally {

          if (
            !controller.signal.aborted
          ) {

            setLoading(
              false
            )
          }

        }
      }


    getData()


    // ==========================================
    // CLEANUP
    // ==========================================

    return () => {

      controller.abort()

    }

  }, [])


  // ============================================
  // RENDER
  // ============================================

  if (loading) {

    return (

      <p role="status">

        Loading...

      </p>

    )
  }


  if (error) {

    return (

      <p role="alert">

        Error:
        {' '}
        {error}

      </p>

    )
  }


  if (!data) {

    return (

      <p>

        No data available.

      </p>

    )
  }


  return (

    <section>

      <h1>

        {data.name}

      </h1>

    </section>

  )
}


================================================================================
CODE BREAKDOWN
================================================================================

+----------------------------+------------------------------------------+
| CODE                       | PURPOSE                                  |
+----------------------------+------------------------------------------+
| useState(null)             | Store backend data                       |
| useState(true)             | Track request progress                   |
| useState(null)             | Store request error                      |
| useEffect(...)             | Synchronize with API                     |
| AbortController()          | Control obsolete request                 |
| fetch()                    | Send HTTP request                        |
| response.ok                | Check HTTP success                       |
| response.json()            | Parse JSON body                          |
| setData()                  | Store successful response                |
| setError()                 | Store failure information                |
| setLoading()               | Control loading UI                       |
| controller.abort()         | Cancel obsolete request                  |
+----------------------------+------------------------------------------+



  return (

    <p role="status">

      Loading groceries...

    </p>

  )
}


if (error) {

  return (

    <p role="alert">

      {error}

    </p>

  )
}


if (
  groceryItems.length === 0
) {

  return (

    <p>

      No grocery items found.

    </p>

  )
}


return (

  <GroceryList
    items={
      groceryItems
    }
    onToggleBought={
      handleToggleBought
    }

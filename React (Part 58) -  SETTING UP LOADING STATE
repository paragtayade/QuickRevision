PART 14: APPLYING LOADING STATE TO THE GROCERY APP
================================================================================

State:

const [
  groceryItems,
  setGroceryItems
] = useState([])


const [
  isLoading,
  setIsLoading
] = useState(true)


const [
  error,
  setError
] = useState(null)


================================================================================
GROCERY FETCH EFFECT
================================================================================

useEffect(() => {

  const controller =
    new AbortController()


  const loadGroceries =
    async () => {

      try {

        setIsLoading(
          true
        )


        setError(
          null
        )


        const response =
          await fetch(
            '/api/groceries',
            {
              signal:
                controller.signal
            }
          )


        if (!response.ok) {

          throw new Error(
            `Unable to load groceries: ${response.status}`
          )
        }


        const groceries =
          await response.json()


        setGroceryItems(
          groceries
        )


      } catch (error) {

        if (
          error.name ===
          'AbortError'
        ) {

          return
        }


        setError(
          error instanceof Error

            ? error.message

            : 'Unable to load groceries'
        )


      } finally {

        if (
          !controller.signal.aborted
        ) {

          setIsLoading(
            false
          )
        }

      }
    }


  loadGroceries()


  return () => {

    controller.abort()

  }

}, [])



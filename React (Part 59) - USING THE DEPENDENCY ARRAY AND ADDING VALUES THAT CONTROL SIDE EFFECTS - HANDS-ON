PART 12: SEARCH BOOKS WITH DEPENDENCY + DEBOUNCE
================================================================================

import {
  useEffect,
  useState
} from 'react'


export default function BookSearch() {

  // ============================================
  // STATE
  // ============================================

  const [
    searchTerm,
    setSearchTerm
  ] = useState('')


  const [
    books,
    setBooks
  ] = useState([])


  const [
    isLoading,
    setIsLoading
  ] = useState(false)


  const [
    error,
    setError
  ] = useState(null)


  // ============================================
  // SEARCH EFFECT
  // ============================================

  useEffect(() => {

    const trimmedSearch =
      searchTerm.trim()


    // Empty search

    if (!trimmedSearch) {

      setBooks([])

      setError(null)

      setIsLoading(false)

      return
    }


    const controller =
      new AbortController()


    const timerId =
      window.setTimeout(
        async () => {

          try {

            setIsLoading(
              true
            )


            setError(
              null
            )


            const response =
              await fetch(
                `/api/books?search=${encodeURIComponent(
                  trimmedSearch
                )}`,
                {
                  signal:
                    controller.signal
                }
              )


            if (!response.ok) {

              throw new Error(
                `Search failed: ${response.status}`
              )
            }


            const data =
              await response.json()


            setBooks(
              data
            )


          } catch (error) {

            if (
              error.name ===
              'AbortError'
            ) {

              return
            }


            setError(
              error instanceof Error
                ? error.message
                : 'Unable to search books'
            )


          } finally {

            if (
              !controller.signal.aborted
            ) {

              setIsLoading(
                false
              )
            }

          }

        },
        500
      )


    // ==========================================
    // CLEANUP
    // ==========================================

    return () => {

      window.clearTimeout(
        timerId
      )


      controller.abort()

    }

  }, [
    searchTerm
  ])


  // ============================================
  // RENDER
  // ============================================

  return (
    <section>

      <label htmlFor="book-search">

        Search Books

      </label>


      <input
        id="book-search"
        type="search"
        value={
          searchTerm
        }
        onChange={
          event =>
            setSearchTerm(
              event.target.value
            )
        }
        placeholder="Search for books..."
      />


      {isLoading && (

        <p role="status">

          Searching...

        </p>

      )}


      {error && (

        <p role="alert">

          {error}

        </p>

      )}


      {!isLoading &&
        !error &&
        searchTerm.trim() &&
        books.length === 0 &&
        (

          <p>

            No books found.

          </p>

        )
      }


      <ul>

        {books.map(
          book => (

            <li key={book.id}>

              {book.title}

            </li>

          )
        )}

      </ul>

    </section>
  )
}


================================================================================
IMPORTANT CORRECTION TO THE ORIGINAL SEARCH EXAMPLE
================================================================================

The original cleanup used only:

clearTimeout(timer)


and described that as:

"cancel fetch if component unmounts."


That is only partially correct.


clearTimeout():

Cancels the delayed function IF it has not started yet.


Once:

fetch()


has already started:

clearTimeout()


does NOT cancel the HTTP request.


Therefore the stronger pattern uses BOTH:

clearTimeout(timerId)

AND:

controller.abort()



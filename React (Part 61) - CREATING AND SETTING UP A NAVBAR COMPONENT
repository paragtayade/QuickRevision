================================================================================
5. CREATE THE NAVBAR COMPONENT
================================================================================

File:

src/components/NavBar.jsx


Code:

function NavBar() {

  return (
    <div>
      NavBar
    </div>
  );

}

export default NavBar;


Explanation:
--------------------------------------------------------------------------------

function NavBar()
-> Creates the React functional component

return (...)
-> Returns the JSX

<div>NavBar</div>
-> Content displayed by the component

export default NavBar
-> Makes the component available to other files


================================================================================
6. IMPORT NAVBAR INTO APP.JSX
================================================================================

File:

src/App.jsx


Code:

import NavBar from './components/NavBar';

function App() {

  return (
    <div>

      <NavBar />

      <p>Hello Bookshelf</p>

    </div>
  );

}

export default App;


Important:

import NavBar from './components/NavBar';
-> Imports the component

<NavBar />
-> Renders the component



19. COMPLETE DEBUGGING EXAMPLE
================================================================================

import { useState, useEffect } from 'react';

import SearchBar from './components/SearchBar';


function App() {

  const [books, setBooks] =
    useState([]);

  const [searchTerm, setSearchTerm] =
    useState('javascript');

  const [isLoading, setIsLoading] =
    useState(false);

  const [error, setError] =
    useState(null);


  const fetchBooks = async (query) => {

    try {

      setIsLoading(true);
      setError(null);


      if (!query.trim()) {

        console.warn(
          'Search term is empty'
        );

        return;

      }


      const URL =
        `https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(query)}`;


      console.log(
        'Fetching:',
        query
      );

      console.log(
        'URL:',
        URL
      );


      const response =
        await fetch(URL);


      console.log(
        'Status:',
        response.status
      );


      if (!response.ok) {

        throw new Error(
          `HTTP error: ${response.status}`
        );

      }


      const data =
        await response.json();


      const bookList =
        data.items || [];


      console.log(
        'Books:',
        bookList.length
      );


      setBooks(bookList);


    } catch (error) {

      console.error(
        'Fetch Error:',
        error
      );

      setError(error.message);
      setBooks([]);


    } finally {

      setIsLoading(false);

    }

  };


  useEffect(() => {

    fetchBooks('javascript');

  }, []);


  const handleSearchChange = (e) => {

    const newValue =
      e.target.value;

    console.log(
      'Search Input:',
      newValue
    );

    setSearchTerm(newValue);

  };


  const handleSearchSubmit = (e) => {

    e.preventDefault();

    console.log(
      'Submitting:',
      searchTerm
    );

    fetchBooks(searchTerm);

  };


  return (

    <main className="container mt-5">

      <h1>Book Search</h1>


      <div className="alert alert-info">

        <p>
          Search Term: {searchTerm}
        </p>

        <p>
          Books: {books.length}
        </p>

        <p>
          Loading:
          {isLoading ? ' Yes' : ' No'}
        </p>

        <p>
          Error:
          {error || ' None'}
        </p>

      </div>


      <SearchBar
        searchTerm={searchTerm}
        onSearchChange={handleSearchChange}
        onSearch={handleSearchSubmit}
      />


      {isLoading && (
        <p>Loading books...</p>
      )}


      {error && (
        <p style={{ color: 'red' }}>
          Error: {error}
        </p>
      )}

    </main>

  );
}

export default App;



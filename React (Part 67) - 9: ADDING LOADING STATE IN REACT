19. WHAT THE CODE DOES
================================================================================

books State:
--------------------------------------------------------------------------------

const [books, setBooks] = useState([]);

- Stores books returned by the API.


Loading State:
--------------------------------------------------------------------------------

const [isLoading, setIsLoading] =
  useState(false);

- Tracks whether a request is running.


Error State:
--------------------------------------------------------------------------------

const [error, setError] =
  useState(null);

- Stores an API error.


Start Loading:
--------------------------------------------------------------------------------

setIsLoading(true);

- Executed before the API call.
- Causes the loading UI to appear.


Clear Error:
--------------------------------------------------------------------------------

setError(null);

- Removes errors from previous searches.


Fetch:
--------------------------------------------------------------------------------

await fetch(URL);

- Sends the API request.


Store Data:
--------------------------------------------------------------------------------

setBooks(data.items || []);

- Stores the returned books.


Error Handling:
--------------------------------------------------------------------------------

catch (error) {
  setError(error.message);
}

- Stores an error message when the request fails.


Stop Loading:
--------------------------------------------------------------------------------

finally {
  setIsLoading(false);
}

- Runs whether fetch succeeds or fails.
- Hides the loading UI.



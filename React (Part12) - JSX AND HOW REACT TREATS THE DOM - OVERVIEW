Example 5: Complex JSX with Multiple Features

================================================================================

import { useState } from 'react';

export default function UserProfile() {

  const [user, setUser] =
    useState({
      name: 'Alice',
      email: 'alice@example.com',
      isActive: true,
      skills: [
        'React',
        'JavaScript',
        'CSS'
      ]
    });

  const toggleStatus = () => {

    setUser({
      ...user,
      isActive: !user.isActive
    });
  };

  return (
    <div className="profile-card">

      <h1>{user.name}</h1>

      <p>
        Email: {user.email}
      </p>

      <p>
        Status:

        <span
          className={
            user.isActive
              ? 'active'
              : 'inactive'
          }
        >
          {user.isActive
            ? 'Active'
            : 'Inactive'}
        </span>

      </p>

      <h3>Skills:</h3>

      <ul>

        {user.skills.map(skill => (

          <li key={skill}>
            {skill}
          </li>

        ))}

      </ul>

      <button
        onClick={toggleStatus}
        className="btn"
      >
        Toggle Status
      </button>

    </div>
  );
}

Important Concepts
Code / Concept                      | Purpose
------------------------------------|--------------------------------------
user.name                           | Reads object property
user.email                          | Displays email
user.isActive ? A : B               | Conditional rendering/value
className={condition ? A : B}       | Dynamic CSS class
user.skills.map(...)                | Renders skills list
key={skill}                         | Identifies each list item
...user                             | Copies current object properties
isActive: !user.isActive            | Toggles boolean state
setUser(...)                        | Updates user state

State Update Flow
Current User Object
       ↓
Spread ...user
       ↓
Copy Existing Properties
       ↓
Change isActive
       ↓
Create New Object
       ↓
setUser()
       ↓
Re-render



REAL-WORLD EXAMPLE 3: LOGIN FORM

================================================================================

JSX - What You Write
import { useState } from 'react';

export default function LoginForm() {

  const [email, setEmail] =
    useState('');

  const [password, setPassword] =
    useState('');

  const handleSubmit = (e) => {

    e.preventDefault();

    console.log(
      'Submitting:',
      {
        email,
        password
      }

================================================================================

After: Using map() (Clean & Scalable)

export default function BookList() {
  const books = [
    { id: 1, title: 'The Great Gatsby', author: 'F. Scott Fitzgerald' },
    { id: 2, title: '1984', author: 'George Orwell' },
    { id: 3, title: 'To Kill a Mockingbird', author: 'Harper Lee' }
  ]

  return (
    <div>
      <h1>Books</h1>
      
      {/* Using map() - clean & scalable */}
      {books.map(book => (
        <div key={book.id}>
          <h2>{book.title}</h2>
          <p>By {book.author}</p>
        </div>
      ))}
    </div>
  )
}
Benefits:

• No repetition • Scales to any number of books • Easy to maintain • Professional approach


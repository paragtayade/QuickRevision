PART 9: MAP() VS OTHER ARRAY METHODS

================================================================================

map() - Transform Each Item

const numbers = [1, 2, 3]
const doubled = numbers.map(n => n * 2)
// Result: [2, 4, 6]
filter() - Keep Only Matching Items

const books = [
  { title: 'Book 1', price: 12.99 },
  { title: 'Book 2', price: 24.99 },
  { title: 'Book 3', price: 11.99 }
]

const affordable = books.filter(book => book.price < 15)
// Result: [Book 1, Book 3]
find() - Find First Matching Item

const books = [
  { id: 1, title: 'Book 1' },
  { id: 2, title: 'Book 2' },
  { id: 3, title: 'Book 3' }
]

const book = books.find(b => b.id === 2)
// Result: { id: 2, title: 'Book 2' }
forEach() - Loop Without Returning

const books = [
  { title: 'Book 1' },
  { title: 'Book 2' }
]

books.forEach(book => {
  console.log(book.title)  // Just logs, doesn't return
})

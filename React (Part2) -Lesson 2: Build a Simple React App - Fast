Final App.js

============================================================

import React, { useState } from 'react';
import './App.css';

export default function App() {

  const [imageUrl, setImageUrl] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const getRandomDog = async () => {

    setLoading(true);
    setError('');

    try {

      const response = await fetch(
        'https://dog.ceo/api/breeds/image/random'
      );

      if (!response.ok) {
        throw new Error('Failed to fetch dog image');
      }

      const data = await response.json();

      setImageUrl(data.message);

    } catch (error) {

      setError(
        'Could not fetch dog image. Please try again.'
      );

      console.error('Error:', error);

    } finally {

      setLoading(false);
    }
  };

  return (
    <div className="container">

      <h1>🐕 Random Puppy Generator</h1>

      <button
        onClick={getRandomDog}
        disabled={loading}
        className="btn"
      >
        {loading
          ? '⏳ Loading...'
          : '🎲 Get Random Puppy'}
      </button>

      {error && (
        <p className="error">
          {error}
        </p>
      )}

      {imageUrl && (
        <div className="image-container">

          <img
            src={imageUrl}
            alt="Random Puppy"
            className="dog-image"
          />

        </div>
      )}

    </div>
  );
}


============================================================

Important Parts of Final Code

============================================================

Code / State                       | Purpose
-----------------------------------|------------------------------------------
imageUrl                           | Stores dog image URL
loading                            | Tracks API loading status
error                              | Stores error message
setLoading(true)                   | Starts loading state
setError('')                       | Clears previous error
response.ok                        | Checks whether response succeeded
setImageUrl(data.message)          | Stores API image URL
setError(...)                      | Stores user-friendly error
finally                            | Runs whether request succeeds or fails
setLoading(false)                  | Stops loading
disabled={loading}                 | Disables button while loading



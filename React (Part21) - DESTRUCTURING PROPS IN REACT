      <h2>{props.title}</h2>

      <p>{props.author}</p>

      <p>${props.price}</p>

    </div>
  );
}

After
function Book({
  title,
  author,
  price
}) {

  return (
    <div>

      <h2>{title}</h2>

      <p>{author}</p>

      <p>${price}</p>

    </div>
  );
}

Benefits
Before             | After
-------------------|--------------------------
props.title        | title
props.author       | author
props.price        | price
More repetition    | Less repetition
Longer JSX         | Cleaner JSX



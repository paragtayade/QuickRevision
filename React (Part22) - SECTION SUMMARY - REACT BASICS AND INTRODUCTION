ESSENTIAL REACT SYNTAX
--------------------------------------------------------------------------------

// Import React and hooks

import React, { useState } from 'react'


// Create a component

export default function ComponentName({
  prop1,
  prop2 = 'default'
}) {

  // State management

  const [state, setState] = useState(initialValue)


  // Event handler

  const handleClick = () => {
    setState(newValue)
  }


  // Return JSX

  return (
    <div>

      {/* Display state */}
      <p>{state}</p>


      {/* Handle events */}
      <button onClick={handleClick}>
        Click
      </button>


      {/* Render lists */}
      {items.map(item => (
        <Item
          key={item.id}
          item={item}
        />
      ))}


      {/* Conditional rendering */}
      {condition && <Component />}

    </div>
  )
}



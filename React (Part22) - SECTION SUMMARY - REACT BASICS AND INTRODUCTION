PART 4: COMPLETE WORKING EXAMPLE
================================================================================

FULL BOOK STORE APP - COMBINING ALL CONCEPTS
--------------------------------------------------------------------------------

import React, { useState } from 'react'
import './App.css'


// Main App Component

export default function App() {

  // State: Array of books
  const [books, setBooks] = useState([
    {
      id: 1,
      title: 'The Great Gatsby',
      author: 'F. Scott Fitzgerald',
      price: 12.99
    },
    {
      id: 2,
      title: '1984',
      author: 'George Orwell',
      price: 14.99
    },
    {
      id: 3,
      title: 'To Kill a Mockingbird',
      author: 'Harper Lee',
      price: 11.99
    }
  ])


  // Function to remove a book

  const removeBook = (id) => {
    setBooks(books.filter(book => book.id !== id))
  }


  return (
    <div className="container">

      <h1>📚 Book Store</h1>

      {/* Render list of books using map() */}

      <div className="books-grid">

        {books.map(book => (

          <BookCard
            key={book.id}
            book={book}
            onRemove={removeBook}
          />

        ))}

      </div>


      {/* Show message if no books */}

      {books.length === 0 && <p>No books available</p>}

    </div>
  )
}


// Child Component: BookCard

function BookCard({ book, onRemove }) {

  return (
    <div className="book-card">

      <h3>{book.title}</h3>

      <p>By {book.author}</p>

      <p className="price">
        ${book.price}
      </p>

      <button onClick={() => onRemove(book.id)}>
        Remove
      </button>

    </div>
  )
}


WHAT THIS APP DEMONSTRATES
--------------------------------------------------------------------------------

✓ Components
  - App and BookCard components

✓ Props
  - Passing book data and onRemove function

✓ State
  - Managing an array of books

✓ map()
  - Rendering a list of books

✓ Keys
  - Using book.id as the key

✓ One-Way Flow
  - Parent updates state
  - Child calls the parent's supplied function

✓ Destructuring
  - { book, onRemove } in BookCard

✓ Conditional Rendering
  - Shows a message when no books remain



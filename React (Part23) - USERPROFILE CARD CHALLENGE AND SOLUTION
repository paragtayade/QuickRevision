Step 3: Create the Main App Component

Now let's create the parent component that manages all the user data:

// File: src/App.jsx

import { useState } from 'react'
import UserProfileCard from './components/UserProfileCard'
import './App.css'

export default function App() {
  
  // State: Array of users
  const [users, setUsers] = useState([
    {
      id: 1,
      name: 'Alice Johnson',
      email: 'alice@example.com',
      role: 'Full Stack Developer',
      avatar: 'https://via.placeholder.com/100?text=Alice',
      bio: 'Passionate about building scalable web applications',
      joinDate: '2023-01-15'
    },
    {
      id: 2,
      name: 'Bob Smith',
      email: 'bob@example.com',
      role: 'UI/UX Designer',
      avatar: 'https://via.placeholder.com/100?text=Bob',
      bio: 'Creating beautiful and intuitive user experiences',
      joinDate: '2023-02-20'
    },
    {
      id: 3,
      name: 'Carol Davis',
      email: 'carol@example.com',
      role: 'Product Manager',
      avatar: 'https://via.placeholder.com/100?text=Carol',
      bio: 'Driving product strategy and user satisfaction',
      joinDate: '2023-03-10'
    }
  ])

  return (
    <div className="app-container">
      
      {/* Header Section */}
      <header className="app-header">
        <h1>👥 User Profiles</h1>
        <p>Meet our amazing team members</p>
      </header>

      {/* Cards Grid - Renders all user cards */}
      <div className="cards-grid">
        {users.map(user => (
          <UserProfileCard 
            key={user.id}
            user={user}
          />
        ))}
      </div>

      {/* Empty State - Shows if no users */}
      {users.length === 0 && (
        <p className="no-users">No users to display</p>
      )}
    </div>
  )
}

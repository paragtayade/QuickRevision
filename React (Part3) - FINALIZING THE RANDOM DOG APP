PART 5: COMPLETE WORKING APP

================================================================================

Full App.js
import React, { useState } from 'react';
import './App.css';

export default function App() {

  // State to store dog image URL
  const [imageUrl, setImageUrl] = useState('');

  // State to track loading
  const [loading, setLoading] = useState(false);

  // State to track errors
  const [error, setError] = useState('');

  // Function to fetch random dog image
  const getRandomDog = async () => {

    setLoading(true);
    setError('');

    try {

      // Fetch from Dog CEO API
      const response = await fetch(
        'https://dog.ceo/api/breeds/image/random'
      );

      // Check if response is successful
      if (!response.ok) {
        throw new Error('Failed to fetch dog image');
      }

      // Convert response to JSON
      const data = await response.json();

      // Extract image URL
      const dogImageUrl = data.message;

      // Update state
      setImageUrl(dogImageUrl);

    } catch (error) {

      // Handle errors
      setError(
        'Could not fetch dog image. Please try again.'
      );

      console.error('Error:', error);

    } finally {

      // Always stop loading
      setLoading(false);
    }
  };

  return (
    <div className="container">

      <h1>🐕 Random Puppy Generator</h1>

      <button
        onClick={getRandomDog}
        disabled={loading}
        className="btn"
      >
        {loading
          ? '⏳ Loading...'
          : '🎲 Get Random Puppy'}
      </button>

      {error && (
        <p className="error">
          {error}
        </p>
      )}

      {imageUrl && (
        <div className="image-container">

          <img
            src={imageUrl}
            alt="Random Puppy"
            className="dog-image"
          />

        </div>
      )}

    </div>
  );
}



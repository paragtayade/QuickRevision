SCENARIO 2: SHOPPING CART
================================================================================

import { useState } from 'react'


export default function ShoppingCart() {

  const [cart, setCart] = useState({

    items: [],

    total: 0,

    itemCount: 0

  })


  // Add item

  const addItem = (product) => {

    setCart(cart => {

      const existingItem =
        cart.items.find(
          item =>
            item.id === product.id
        )


      if (existingItem) {

        return {

          ...cart,

          items:
            cart.items.map(item =>

              item.id === product.id
                ? {
                    ...item,
                    quantity:
                      item.quantity + 1
                  }
                : item

            ),

          total:
            cart.total +
            product.price,

          itemCount:
            cart.itemCount + 1

        }
      }


      return {

        ...cart,

        items: [
          ...cart.items,

          {
            ...product,
            quantity: 1
          }
        ],

        total:
          cart.total +
          product.price,

        itemCount:
          cart.itemCount + 1

      }
    })
  }


  // Remove an entire product entry

  const removeItem = (productId) => {

    setCart(cart => {

      const item =
        cart.items.find(
          item =>
            item.id === productId
        )


      if (!item) {
        return cart
      }


      return {

        ...cart,

        items:
          cart.items.filter(
            item =>
              item.id !== productId
          ),

        total:
          cart.total -
          item.price * item.quantity,

        itemCount:
          cart.itemCount -
          item.quantity

      }
    })
  }


  // Change quantity

  const updateQuantity =
    (productId, newQuantity) => {

      if (newQuantity <= 0) {

        removeItem(productId)

        return
      }


      setCart(cart => {

        const item =
          cart.items.find(
            item =>
              item.id === productId
          )


        if (!item) {
          return cart
        }


        const quantityDifference =
          newQuantity -
          item.quantity


        return {

          ...cart,

          items:
            cart.items.map(item =>

              item.id === productId
                ? {
                    ...item,
                    quantity:
                      newQuantity
                  }
                : item

            ),

          total:
            cart.total +
            item.price *
            quantityDifference,

          itemCount:
            cart.itemCount +
            quantityDifference

        }
      })
    }


  // Clear cart

  const clearCart = () => {

    setCart({
      items: [],
      total: 0,
      itemCount: 0
    })
  }


  return (
    <div>

      <h2>
        Shopping Cart
      </h2>


      <p>
        Items: {cart.itemCount}
      </p>


      <p>
        Total:
        ${cart.total.toFixed(2)}
      </p>


      {cart.items.length === 0 ? (

        <p>
          Cart is empty
        </p>

      ) : (

        <ul>

          {cart.items.map(item => (

            <li key={item.id}>

              {item.name}
              {' - '}
              ${item.price}
              {' x '}
              {item.quantity}


              <button
                onClick={() =>
                  updateQuantity(
                    item.id,
                    item.quantity + 1
                  )
                }
              >
                +
              </button>


              <button
                onClick={() =>
                  updateQuantity(
                    item.id,
                    item.quantity - 1
                  )
                }
              >
                -
              </button>


              <button
                onClick={() =>
                  removeItem(item.id)
                }
              >
                Remove
              </button>

            </li>

          ))}

        </ul>

      )}


      <button onClick={clearCart}>
        Clear Cart
      </button>

    </div>
  )
}


SHOPPING CART OPERATIONS
--------------------------------------------------------------------------------

+-------------------+-----------------------------+----------------------------+
| OPERATION         | STATE CHANGE                | RESULT                     |
+-------------------+-----------------------------+----------------------------+
| Add New Item      | Append product              | New cart line              |
|                   | total + price               | Total increases            |
|                   | itemCount + 1               | Count increases            |
| Add Existing      | quantity + 1                | Quantity increases         |
|                   | total + price               | Total increases            |
|                   | itemCount + 1               | Count increases            |
| Remove Item       | filter() item               | Product removed            |
|                   | subtract price × quantity   | Total decreases            |
|                   | subtract quantity           | Count decreases            |
| Update Quantity   | map() matching item         | Quantity changes           |
|                   | adjust total                | Total recalculated         |
|                   | adjust itemCount            | Count adjusted             |
| Clear Cart        | items = []                  | Products removed           |
|                   | total = 0                   | Total reset                |
|                   | itemCount = 0               | Count reset                |
+-------------------+-----------------------------+----------------------------+


IMPORTANT CART DESIGN NOTE
--------------------------------------------------------------------------------

The example stores:

• items
• total
• itemCount

inside state.

total and itemCount are derived from items and therefore could instead be
calculated from cart.items.

For a teaching example, keeping all three demonstrates synchronized updates.

For production code, deriving totals from a single source of truth often
reduces synchronization bugs.


================================================================================
PART 5: COMMON STATE MISTAKES AND HOW TO FIX THEM
================================================================================

MISTAKE 1: MUTATING STATE DIRECTLY
================================================================================

WRONG:
--------------------------------------------------------------------------------

const [user, setUser] =
  useState({
    name: 'John'
  })


user.name = newName


CORRECT:
--------------------------------------------------------------------------------

setUser(user => ({

  ...user,

  name: newName

}))


WHY?
--------------------------------------------------------------------------------

Direct mutation modifies the existing object.

Create a replacement object and pass it to the state setter.


================================================================================
MISTAKE 2: NOT USING THE STATE SETTER
================================================================================

WRONG IDEA:
--------------------------------------------------------------------------------

count = count + 1


CORRECT:
--------------------------------------------------------------------------------

setCount(count => count + 1)


WHY?
--------------------------------------------------------------------------------

State should be changed through its setter.


================================================================================
MISTAKE 3: EXPECTING CURRENT STATE VARIABLE TO CHANGE IMMEDIATELY
================================================================================

MISLEADING EXPECTATION:
--------------------------------------------------------------------------------

const increment = () => {

  setCount(count + 1)

  console.log(count)

  // Still sees count from this render
}


BETTER MENTAL MODEL:
--------------------------------------------------------------------------------

Each render receives a snapshot of state.

Calling setCount():

• Requests/queues the next state

• Does not rewrite count inside the running handler


IF YOU NEED THE CALCULATED NEXT VALUE:
--------------------------------------------------------------------------------

const increment = () => {

  const newCount =
    count + 1

  setCount(newCount)

  console.log(newCount)
}


IF NEXT STATE DEPENDS ON PREVIOUS STATE:
--------------------------------------------------------------------------------

setCount(previous =>
  previous + 1
)


================================================================================
MISTAKE 4: MUTATING ARRAYS
================================================================================

WRONG:
--------------------------------------------------------------------------------

items.push(item)

setItems(items)


CORRECT:
--------------------------------------------------------------------------------

setItems(items => [
  ...items,
  item
])


WHY?
--------------------------------------------------------------------------------

push() changes the existing array.

Spread creates a new array.


================================================================================
MISTAKE 5: MUTATING NESTED OBJECTS
================================================================================

WRONG:
--------------------------------------------------------------------------------

state.user.address.city =
  'Mumbai'


CORRECT:
--------------------------------------------------------------------------------

setState(state => ({

  ...state,

  user: {

    ...state.user,

    address: {

      ...state.user.address,

      city: 'Mumbai'

    }

  }

}))


================================================================================
COMMON MISTAKES TABLE
================================================================================

+-----------------------+--------------------------+-----------------------------+
| MISTAKE               | WRONG                    | CORRECT                     |
+-----------------------+--------------------------+-----------------------------+
| Object mutation       | state.prop = value       | {...state, prop: value}    |
| No setter             | regular assignment       | setter(nextState)          |
| Array mutation        | array.push(item)         | [...array, item]           |
| Same mutated ref      | setArray(array)          | create new array           |
| Nested mutation       | state.a.b = value        | copy each modified level   |
| Sort mutation         | array.sort()             | [...array].sort()          |
| Previous-state update | setCount(count + 1)      | setCount(c => c + 1)       |
| List identity         | key={index} when unstable| stable unique ID           |
| Conditional mutation  | if(x) state.prop = y     | if(x) setter(...)          |
+-----------------------+--------------------------+-----------------------------+


IMPORTANT CORRECTION:
--------------------------------------------------------------------------------

Do NOT write:

await setState(value)

useState setters do NOT return a Promise that you await to obtain the
updated state.

Instead, design code around:

• State snapshots
• Subsequent renders
• Effects when synchronization with an external system is truly needed



import {
  render,
  screen
} from '@testing-library/react'

import userEvent
  from '@testing-library/user-event'

import Counter
  from './Counter'


test(
  'increments count when button clicked',

  async () => {

    const user =
      userEvent.setup()


    render(
      <Counter />
    )


    expect(
      screen.getByText(
        /count: 0/i
      )
    ).toBeInTheDocument()


    await user.click(
      screen.getByRole(
        'button',
        {
          name: /increment/i
        }
      )
    )


    expect(
      screen.getByText(
        /count: 1/i
      )
    ).toBeInTheDocument()
  }
)



SCENARIO 1: USER AUTHENTICATION
================================================================================

import { useState } from 'react'


export default function AuthExample() {

  const [auth, setAuth] = useState({

    isLoggedIn: false,

    user: null,

    token: null,

    loading: false,

    error: null

  })


  const login =
    async (email, password) => {

      setAuth(auth => ({
        ...auth,
        loading: true,
        error: null
      }))


      try {

        const response =
          await fetch('/api/login', {

            method: 'POST',

            headers: {
              'Content-Type':
                'application/json'
            },

            body:
              JSON.stringify({
                email,
                password
              })

          })


        if (!response.ok) {

          throw new Error(
            'Login failed'
          )
        }


        const data =
          await response.json()


        setAuth({

          isLoggedIn: true,

          user: data.user,

          token: data.token,

          loading: false,

          error: null

        })

      } catch (error) {

        setAuth(auth => ({

          ...auth,

          loading: false,

          error: error.message

        }))

      }
    }


  const logout = () => {

    setAuth({

      isLoggedIn: false,

      user: null,

      token: null,

      loading: false,

      error: null

    })
  }


  return (
    <div>

      {auth.loading && (
        <p>Loading...</p>
      )}


      {auth.error && (
        <p>
          Error: {auth.error}
        </p>
      )}


      {auth.isLoggedIn ? (

        <>

          <p>
            Welcome, {auth.user?.name}!
          </p>

          <button onClick={logout}>
            Logout
          </button>

        </>

      ) : (

        <button
          onClick={() =>
            login(
              'user@example.com',
              'password'
            )
          }
        >
          Login
        </button>

      )}

    </div>
  )
}


AUTHENTICATION STATE
--------------------------------------------------------------------------------

+------------------+---------------------------------------------+
| PROPERTY         | PURPOSE                                     |
+------------------+---------------------------------------------+
| isLoggedIn       | Tracks authentication state                 |
| user             | Stores authenticated user data              |
| token            | Stores token in this simplified example     |
| loading          | Tracks login request                        |
| error            | Stores authentication error                 |
+------------------+---------------------------------------------+


AUTHENTICATION FLOW
--------------------------------------------------------------------------------

Login
  ↓
set loading = true
  ↓
API Request
  ↓
+------------------------+
|                        |
Success                Failure
|                        |
↓                        ↓
Store User             Store Error
Store Token            loading = false
isLoggedIn = true
|
↓
Render Logged-In UI


NOTE:
--------------------------------------------------------------------------------

The token handling shown here is a simplified state example.

Production authentication requires additional security considerations
and should not be designed solely around this teaching example.



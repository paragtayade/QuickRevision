Problem 6: Code Can Become Messy and Difficult to Maintain

================================================================================

Real-World Example: Todo App

With Vanilla JavaScript, managing state, filtering, DOM updates, and event listeners manually can produce substantial coordination code.

let todos = [];
let filteredTodos = [];
let selectedFilter = 'all';

function addTodo(text) {

  const todo = {
    id: Date.now(),
    text,
    completed: false
  };

  todos.push(todo);

  updateDisplay();
  updateFilteredList();
}

function deleteTodo(id) {

  todos =
    todos.filter(t => t.id !== id);

  updateDisplay();
  updateFilteredList();
}

function toggleTodo(id) {

  const todo =
    todos.find(t => t.id === id);

  if (todo) {

    todo.completed =
      !todo.completed;

    updateDisplay();
    updateFilteredList();
  }
}

function setFilter(filter) {

  selectedFilter = filter;

  updateFilteredList();
  updateDisplay();
}

function updateFilteredList() {

  if (selectedFilter === 'all') {

    filteredTodos = todos;

  } else if (selectedFilter === 'active') {

    filteredTodos =
      todos.filter(t => !t.completed);

  } else if (selectedFilter === 'completed') {

    filteredTodos =
      todos.filter(t => t.completed);
  }
}

function updateDisplay() {

  const list =
    document.getElementById('todoList');

  list.innerHTML = '';

  filteredTodos.forEach(todo => {

    const li =
      document.createElement('li');

    li.textContent =
      todo.text;

    if (todo.completed) {
      li.style.textDecoration =
        'line-through';
    }

    list.appendChild(li);
  });
}

// Event listeners

document
  .getElementById('addBtn')
  .addEventListener('click', () => {

    const input =
      document.getElementById('todoInput');

    addTodo(input.value);

    input.value = '';
  });

document
  .getElementById('filterAll')
  .addEventListener('click', () => {
    setFilter('all');
  });

document
  .getElementById('filterActive')
  .addEventListener('click', () => {
    setFilter('active');
  });

document
  .getElementById('filterCompleted')
  .addEventListener('click', () => {
    setFilter('completed');
  });

Problems as Complexity Grows
Problem                    | Why It Matters
---------------------------|--------------------------------------------
Manual state management    | Developer tracks updates manually
Multiple DOM updates       | Many functions manipulate the UI
Manual synchronization     | Must remember when to update display
Tracking application flow  | Becomes difficult as features increase
State + DOM coordination   | Updates are closely connected
Debugging                  | More paths must be investigated
Team readability           | Larger imperative code is harder to follow
Bug risk                   | Easy to miss an update/dependency



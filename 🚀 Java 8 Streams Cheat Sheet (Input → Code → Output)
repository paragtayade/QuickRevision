🚀 Java 8 Programming Interview Questions (Text Format)
Fast Revision | Question → Code
Filter Even Numbers
list.stream()
    .filter(n -> n % 2 == 0)
    .toList();

Filter Odd Numbers
list.stream()
    .filter(n -> n % 2 != 0)
    .toList();

Convert to Uppercase
names.stream()
     .map(String::toUpperCase)
     .toList();

Convert to Lowercase
names.stream()
     .map(String::toLowerCase)
     .toList();

Sum of Numbers
list.stream()
    .mapToInt(Integer::intValue)
    .sum();

Average of Numbers
list.stream()
    .mapToInt(Integer::intValue)
    .average();

Maximum Number
list.stream()
    .max(Integer::compareTo)
    .get();

Minimum Number
list.stream()
    .min(Integer::compareTo)
    .get();

Count Elements
list.stream()
    .count();

Remove Duplicates
list.stream()
    .distinct()
    .toList();

Sort Ascending
list.stream()
    .sorted()
    .toList();

Sort Descending
list.stream()
    .sorted(Comparator.reverseOrder())
    .toList();

Get First Element
list.stream()
    .findFirst()
    .get();

Check Any Match
list.stream()
    .anyMatch(n -> n > 50);

Check All Match
list.stream()
    .allMatch(n -> n > 0);

Check None Match
list.stream()
    .noneMatch(n -> n < 0);

Skip First 2 Elements
list.stream()
    .skip(2)
    .toList();

Get First 3 Elements
list.stream()
    .limit(3)
    .toList();

Sort String By Length
names.stream()
     .sorted(Comparator.comparing(String::length))
     .toList();

Join Strings
names.stream()
     .collect(Collectors.joining(","));

Convert List To Set
list.stream()
    .collect(Collectors.toSet());

Convert List To Map
employees.stream()
         .collect(Collectors.toMap(
             Employee::getId,
             Employee::getName));

Group Employees By Department
employees.stream()
         .collect(Collectors.groupingBy(
             Employee::getDept));

Partition Employees By Salary
employees.stream()
         .collect(Collectors.partitioningBy(
             e -> e.getSalary() > 50000));

Highest Salary Employee
employees.stream()
         .max(Comparator.comparing(
             Employee::getSalary))
         .get();

Lowest Salary Employee
employees.stream()
         .min(Comparator.comparing(
             Employee::getSalary))
         .get();

Second Highest Number
list.stream()
    .sorted(Comparator.reverseOrder())
    .skip(1)
    .findFirst();

Third Highest Number
list.stream()
    .sorted(Comparator.reverseOrder())
    .skip(2)
    .findFirst();

Nth Highest Number
list.stream()
    .sorted(Comparator.reverseOrder())
    .skip(n - 1)
    .findFirst();

Find Duplicate Elements
Set<Integer> set = new HashSet<>();

list.stream()
    .filter(n -> !set.add(n))
    .toList();

Find Unique Elements
list.stream()
    .filter(n ->
      Collections.frequency(list,n)==1)
    .toList();

Frequency Of Elements
list.stream()
    .collect(Collectors.groupingBy(
        Function.identity(),
        Collectors.counting()));

Longest String
names.stream()
     .max(Comparator.comparing(
        String::length));

Shortest String
names.stream()
     .min(Comparator.comparing(
        String::length));

Sum Employee Salaries
employees.stream()
         .mapToDouble(
            Employee::getSalary)
         .sum();

Average Employee Salary
employees.stream()
         .collect(
           Collectors.averagingDouble(
           Employee::getSalary));

Extract Employee Names
employees.stream()
         .map(Employee::getName)
         .toList();

Employee Names To Uppercase
employees.stream()
         .map(e ->
          e.getName().toUpperCase())
         .toList();

Flatten Nested Lists
lists.stream()
     .flatMap(List::stream)
     .toList();

Count Words In String
Arrays.stream(str.split(" "))
      .count();

Count Characters
str.chars()
   .count();

Array To List
Arrays.stream(arr)
      .toList();

List To Array
list.toArray(String[]::new);

Reverse String
new StringBuilder(str)
    .reverse()
    .toString();

Palindrome Check
str.equals(
new StringBuilder(str)
.reverse()
.toString());

Count Vowels
str.chars()
   .filter(c ->
      "aeiou".indexOf(c) >= 0)
   .count();

Remove Null Values
list.stream()
    .filter(Objects::nonNull)
    .toList();

Method Reference
names.forEach(
    System.out::println);

Parallel Stream
list.parallelStream()
    .forEach(System.out::println);

Reduce For Sum
list.stream()
    .reduce(0,
       Integer::sum);

Reduce For Product
list.stream()
    .reduce(1,
      (a,b)->a*b);

Functional Interface Questions
Predicate
Predicate<Integer> even =
    n -> n % 2 == 0;

even.test(10);

Function
Function<String,Integer> len =
    String::length;

len.apply("Java");

Consumer
Consumer<String> print =
    System.out::println;

print.accept("Hello");

Supplier
Supplier<String> s =
    () -> "Java";

s.get();

BiFunction
BiFunction<Integer,Integer,Integer> add =
    (a,b) -> a+b;

add.apply(5,3);

BinaryOperator
BinaryOperator<Integer> add =
    (a,b) -> a+b;

UnaryOperator
UnaryOperator<String> upper =
    s -> s.toUpperCase();


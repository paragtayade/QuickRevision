Code :
BinaryOperator<Integer> max =
Integer::max;

Input  : 20,50
Output : 50

Method : apply()



UnaryOperator<T>

Code :
UnaryOperator<String> upper =
s -> s.toUpperCase();

Input  : "java"
Output : JAVA

Method : apply()

⭐ Most Asked Stream Questions Using Functional Interfaces
Filter Even Numbers

Code :
list.stream()
    .filter(n -> n % 2 == 0)
    .toList();

Input  : [1,2,3,4,5,6]

Output :
[2,4,6]


Convert To Uppercase

Code :
names.stream()
     .map(String::toUpperCase)
     .toList();

Input  : [java,spring]

Output :
[JAVA,SPRING]


Find Length Of Strings

Code :
names.stream()
     .map(String::length)
     .toList();

Input  : [Java,AWS]

Output :
[4,3]


Sum Numbers

Code :
list.stream()
    .reduce(0,Integer::sum);

Input  : [10,20,30]

Output :
60


Find Maximum Number

Code :
list.stream()
    .max(Integer::compareTo)
    .get();

Input  : [10,50,30]

Output :
50


Group Employees By Department

Code :
employees.stream()
.collect(Collectors.groupingBy(Employee::getDept));

Input :
John IT
Mary IT
Tom HR

Output :
{IT=[John,Mary], HR=[Tom]}


Convert List To Map

Code :
employees.stream()
.collect(Collectors.toMap(Employee::getId,Employee::getName));

Input :
1 John
2 Mary

Output :
{1=John, 2=Mary}


Find Duplicate Elements

Code :
list.stream()
.collect(Collectors.groupingBy(Function.identity(),
Collectors.counting()));

Input :
[1,2,2,3,3,3]

Output :
{1=1,2=2,3=3}

